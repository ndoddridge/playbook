@using Playbook.Core.Predictions

<nav class="qp-slate-nav" aria-label="NFL slate">
    <div class="qp-slate-nav__bar">
        <button type="button"
                class="qp-slate-nav__step"
                disabled="@(!CanGoPrevious)"
                @onclick="GoPrevious"
                aria-label="Previous slate">
            ‹
        </button>

        <button type="button"
                class="qp-slate-nav__current"
                @onclick="ToggleBrowse"
                aria-expanded="@_browseOpen"
                aria-controls="qp-week-picker">
            <span class="qp-slate-nav__label">@Selected.CompactLabel</span>
        </button>

        <button type="button"
                class="qp-slate-nav__step"
                disabled="@(!CanGoNext)"
                @onclick="GoNext"
                aria-label="Next slate">
            ›
        </button>
    </div>

    <button type="button"
            class="qp-slate-nav__browse"
            @onclick="ToggleBrowse"
            aria-expanded="@_browseOpen"
            aria-controls="qp-week-picker">
        @(_browseOpen ? "Hide weeks" : "Browse weeks")
        <span class="qp-slate-nav__browse-chevron" aria-hidden="true">@(_browseOpen ? "▴" : "▾")</span>
    </button>

    <div id="qp-week-picker"
         class="qp-week-picker @(_browseOpen ? "qp-week-picker--open" : null)"
         aria-hidden="@(!_browseOpen)">
        @if (_browseOpen)
        {
            <div class="qp-week-picker__panel">
                @foreach (var group in PhaseGroups)
                {
                    <div class="qp-week-picker__phase">
                        <p class="qp-week-picker__phase-label">@group.Label</p>
                        <div class="qp-week-picker__chips" role="list">
                            @foreach (var week in group.Weeks)
                            {
                                var isActive = week == Selected;
                                var hasMarkets = MarketWeeks.Contains(week);
                                <button type="button"
                                        role="listitem"
                                        class="qp-week-chip @(isActive ? "qp-week-chip--active" : null) @(hasMarkets ? "qp-week-chip--live" : "qp-week-chip--empty")"
                                        @onclick="() => Select(week)"
                                        aria-current="@(isActive ? "true" : "false")"
                                        title="@(hasMarkets ? week.DisplayLabel : $"{week.DisplayLabel} · no markets yet")">
                                    @week.ShortLabel
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</nav>

@code {
    [Parameter, EditorRequired]
    public NflWeekRef Selected { get; set; } = default!;

    [Parameter, EditorRequired]
    public IReadOnlyList<NflWeekRef> CanonicalWeeks { get; set; } = [];

    [Parameter]
    public IReadOnlyList<NflWeekRef> MarketWeeks { get; set; } = [];

    [Parameter]
    public EventCallback<NflWeekRef> OnSelected { get; set; }

    private bool _browseOpen;

    private IReadOnlyList<PhaseGroup> PhaseGroups =>
        CanonicalWeeks
            .GroupBy(w => w.Phase)
            .OrderBy(g => g.First().PhaseOrder)
            .Select(g => new PhaseGroup(
                g.Key switch
                {
                    NflSeasonPhase.Preseason => "PRESEASON",
                    NflSeasonPhase.RegularSeason => "REGULAR SEASON",
                    NflSeasonPhase.Postseason => "POSTSEASON",
                    _ => g.Key.ToString().ToUpperInvariant()
                },
                g.OrderBy(w => w.Week).ToList()))
            .ToList();

    private int SelectedIndex =>
        Math.Max(0, CanonicalWeeks.ToList().FindIndex(w => w == Selected));

    private bool CanGoPrevious => SelectedIndex > 0;

    private bool CanGoNext => SelectedIndex >= 0 && SelectedIndex < CanonicalWeeks.Count - 1;

    private Task GoPrevious() =>
        CanGoPrevious ? Select(CanonicalWeeks[SelectedIndex - 1]) : Task.CompletedTask;

    private Task GoNext() =>
        CanGoNext ? Select(CanonicalWeeks[SelectedIndex + 1]) : Task.CompletedTask;

    private void ToggleBrowse() => _browseOpen = !_browseOpen;

    private async Task Select(NflWeekRef slate)
    {
        await OnSelected.InvokeAsync(slate);
    }

    private sealed record PhaseGroup(string Label, IReadOnlyList<NflWeekRef> Weeks);
}
