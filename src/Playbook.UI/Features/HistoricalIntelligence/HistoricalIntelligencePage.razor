@page "/historical-intelligence"
@using Playbook.Application.Historical
@inject IHistoricalLeagueIntelligenceService Historical

<PageTitle>Historical League Intelligence - Playbook</PageTitle>
<section class="pb-page hi-page">
    <header class="pb-page__header"><h1 class="pb-page__title">Historical League Intelligence</h1><p class="pb-page__subtitle">Descriptive evidence from completed drafts. It is not used for live draft recommendations.</p></header>
    <section class="hi-card"><h2>Import historical season</h2><div class="hi-row"><input @bind="sleeperLeagueId" placeholder="Sleeper league ID" /><button @onclick="ImportSleeperAsync">Import linked Sleeper history</button></div><details><summary>Structured draft import</summary><textarea @bind="importJson" placeholder="HistoricalLeagueDraft JSON"></textarea><button @onclick="ImportJsonAsync">Validate and import JSON</button></details><details><summary>Historical ADP snapshot import</summary><p><small>Requires actual source, season, scoring format, stable player IDs, and snapshot date. Current or undated ADP cannot evaluate past drafts.</small></p><textarea @bind="adpJson" placeholder="HistoricalAdpSnapshot JSON"></textarea><button @onclick="ImportAdpAsync">Import snapshot</button></details>@if (!string.IsNullOrWhiteSpace(message)) { <p class="@(failed ? "hi-error" : "hi-success")">@message</p> }</section>
    <section class="hi-card"><h2>Historical drafts</h2>@if (drafts.Count == 0) { <p>No historical drafts imported yet.</p> } else { <div class="hi-grid">@foreach (var draft in drafts) { <article><strong>@draft.LeagueName · @draft.Season</strong><br />@draft.TeamCount teams · @draft.RoundCount rounds · @draft.Picks.Count picks<br /><small>@draft.LeagueType · @draft.Source · @draft.HistoricalAdpSnapshots.Count ADP snapshot(s)</small></article> }</div> }</section>
    @if (drafts.Count > 0) { var primary = drafts.First(); <section class="hi-card"><h2>Player history</h2><div class="hi-row"><input @bind="targetPlayerKey" placeholder="Sleeper player ID" /><input type="number" @bind="currentPick" /><input type="number" @bind="nextPick" /><button @onclick="QueryTarget">Assess availability</button></div>@if (target is not null) { <p><strong>@target.Availability.Assessment</strong> - @target.Availability.Explanation</p><small>Historical ADP: @(target.HistoricalAdp?.Adp?.ToString("0.0") ?? "unavailable") · Evidence: @target.Availability.EvidenceStrength</small> }<div class="hi-grid">@foreach (var range in Historical.GetLeaguePlayerRanges(primary.LeagueId).Take(12)) { <article><strong>@range.PlayerName</strong><br />Picks @range.MinimumPick-@range.MaximumPick · median @range.MedianPick<br /><small>@range.DraftCount drafts · @range.EvidenceStrength</small></article> }</div></section><section class="hi-card"><h2>League tendencies</h2><div class="hi-grid">@foreach (var tendency in Historical.GetLeaguePositionTendencies(primary.LeagueId)) { <article><strong>@tendency.Position</strong><br />First: @tendency.FirstSelectedPick · average @tendency.AveragePick.ToString("0.0")<br /><small>@tendency.DraftCount selections · @tendency.EvidenceStrength</small></article> }</div></section><section class="hi-card"><h2>Owner patterns</h2><p>Small samples remain insufficient.</p><div class="hi-grid">@foreach (var tendency in Historical.GetOwnerMarketSignals(primary.LeagueId).Take(12)) { <article><strong>@tendency.OwnerName</strong><br />@tendency.Position · @tendency.SelectionCount picks · ADP delta @(tendency.AverageAdpDelta?.ToString("+0.0;-0.0") ?? "unavailable")<br /><small>@tendency.SeasonCount season(s) · @tendency.EvidenceStrength</small></article> }</div></section> }
</section>
@code { private string sleeperLeagueId = string.Empty, importJson = string.Empty, adpJson = string.Empty, targetPlayerKey = string.Empty, message = string.Empty; private int currentPick = 1, nextPick = 12; private bool failed; private Playbook.Core.Historical.HistoricalTargetPlayerQuery? target; private IReadOnlyList<Playbook.Core.Historical.HistoricalLeagueDraft> drafts = []; protected override void OnInitialized() => Refresh(); private async Task ImportSleeperAsync() => Show(await Historical.ImportSleeperLeagueHistoryAsync(sleeperLeagueId)); private async Task ImportJsonAsync() => Show(await Historical.ImportJsonAsync(importJson)); private async Task ImportAdpAsync() => Show(await Historical.ImportAdpSnapshotJsonAsync(adpJson)); private void QueryTarget() { if (drafts.Count > 0 && !string.IsNullOrWhiteSpace(targetPlayerKey)) target = Historical.QueryTargetPlayer(drafts.First().LeagueId, targetPlayerKey, currentPick, nextPick); } private void Show(Playbook.Core.Historical.HistoricalImportResult result) { failed = !result.Succeeded; message = result.Succeeded ? $"Import complete. {string.Join(" ", result.Warnings)}" : string.Join(" ", result.Errors); Refresh(); } private void Refresh() => drafts = Historical.GetDrafts(); }
