{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "PlayerData": {
    "Provider": "Live",
    "Sleeper": {
      "BaseUrl": "https://api.sleeper.app/v1/",
      "ApiKey": "",
      "TimeoutSeconds": 30
    }
  },
  "News": {
    "Provider": "Live",
    "Espn": {
      "BaseUrl": "https://site.api.espn.com/apis/site/v2/",
      "ApiKey": "",
      "Limit": 40,
      "TimeoutSeconds": 30
    }
  },
  "BackgroundRefresh": {
    "Enabled": true,
    "IntervalMinutes": 15
  },
  "PlayerStats": {
    "Provider": "Live",
    "HistoricalSeasonCount": 3,
    "CacheFileName": "player-stats-cache.json",
    "CacheTtlMinutes": 360,
    "TimeoutSeconds": 90
  },
  "CollegeStats": {
    "Provider": "Live",
    "CacheFileName": "college-stats-cache.json",
    "CacheTtlMinutes": 1440,
    "TimeoutSeconds": 90,
    "MaxConcurrency": 8,
    "MaxAthletesPerSync": 400,
    "CareerPromotionYearsProThreshold": 3
  },
  "Injuries": {
    "Provider": "Live",
    "HistoricalProvider": "Nflverse",
    "HistoricalSeasonCount": 8,
    "CacheFileName": "player-injuries-cache.json",
    "CacheTtlMinutes": 180,
    "TimeoutSeconds": 90
  },
  "Intelligence": {
    "Scoring": {
      "BaselineScore": 50,
      "Rules": [
        { "RuleId": "injury-limited", "HealthDelta": -25 },
        { "RuleId": "injury-questionable", "HealthDelta": -20 },
        { "RuleId": "injury-doubtful", "HealthDelta": -30 },
        { "RuleId": "injury-out", "HealthDelta": -40, "RiskDelta": 25 },
        { "RuleId": "injury-ir", "HealthDelta": -45, "RiskDelta": 30 },
        { "RuleId": "injury-positive", "HealthDelta": 15 },
        { "RuleId": "injury-unconfirmed", "HealthDelta": -8, "RiskDelta": 6 },
        { "RuleId": "injury-reported", "HealthDelta": -12, "RiskDelta": 8 },
        { "RuleId": "injury-historical", "HealthDelta": -6, "RiskDelta": 8 },
        { "RuleId": "suspension", "HealthDelta": -35, "RiskDelta": 30, "OpportunityDelta": -10 },
        { "RuleId": "opportunity-start", "OpportunityDelta": 20, "UsageDelta": 10 },
        { "RuleId": "usage-first-team", "UsageDelta": 15, "OpportunityDelta": 10 },
        { "RuleId": "usage-snap", "UsageDelta": 12 },
        { "RuleId": "depth-chart", "OpportunityDelta": 8, "UsageDelta": 5 },
        { "RuleId": "transaction-signed", "OpportunityDelta": -15 },
        { "RuleId": "transaction-released", "OpportunityDelta": 12 },
        { "RuleId": "transaction-trade", "OpportunityDelta": 10, "UsageDelta": 5 },
        { "RuleId": "coaching", "UsageDelta": 10 },
        { "RuleId": "contract", "OpportunityDelta": 5 },
        { "RuleId": "weather", "RiskDelta": 8, "HealthDelta": -5 },
        { "RuleId": "practice-camp", "MomentumDelta": 5 }
      ]
    }
  },
  "Projection": {
    "Rules": {
      "OpportunityVolumeFactor": 0.22,
      "UsageVolumeFactor": 0.14,
      "HealthDownsideFactor": 0.30,
      "HealthUpsideFactor": 0.06,
      "RiskDownsideFactor": 0.18,
      "UsageCeilingFactor": 0.20,
      "TrendFactor": 0.08,
      "BaseFloorSpread": 2.8,
      "BaseCeilingSpread": 3.2,
      "VolatilityFromLowConfidence": 0.40,
      "BaselineVolatility": 18,
      "IntelligenceConfidenceWeight": 0.65,
      "MinProjection": 0,
      "MaxProjection": 45
    }
  }
}
