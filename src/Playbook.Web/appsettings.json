{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Leagues": {
    "EnableMockLeagues": false
  },
  "PlayerData": {
    "Provider": "Live",
    "Sleeper": {
      "BaseUrl": "https://api.sleeper.app/v1/",
      "ApiKey": "",
      "TimeoutSeconds": 30
    }
  },
  "News": {
    "Provider": "Live",
    "Espn": {
      "BaseUrl": "https://site.api.espn.com/apis/site/v2/",
      "ApiKey": "",
      "Limit": 40,
      "TimeoutSeconds": 30
    }
  },
  "BackgroundRefresh": {
    "Enabled": true,
    "IntervalMinutes": 15
  },
  "PlayerStats": {
    "Provider": "Live",
    "HistoricalProvider": "Nflverse",
    "HistoricalSeasonCount": 5,
    "GameLogSeasonCount": 3,
    "CacheFileName": "player-stats-cache.json",
    "GameLogCacheFileName": "player-game-logs-cache.json",
    "CacheTtlMinutes": 360,
    "TimeoutSeconds": 120
  },
  "CollegeStats": {
    "Provider": "Live",
    "CacheFileName": "college-stats-cache.json",
    "CacheTtlMinutes": 1440,
    "TimeoutSeconds": 90,
    "MaxConcurrency": 8,
    "MaxAthletesPerSync": 400,
    "CareerPromotionYearsProThreshold": 3
  },
  "Injuries": {
    "Provider": "Live",
    "HistoricalProvider": "Nflverse",
    "HistoricalSeasonCount": 8,
    "CacheFileName": "player-injuries-cache.json",
    "CacheTtlMinutes": 180,
    "TimeoutSeconds": 90
  },
  "Intelligence": {
    "Scoring": {
      "BaselineScore": 50,
      "Rules": [
        { "RuleId": "injury-limited", "HealthDelta": -25 },
        { "RuleId": "injury-questionable", "HealthDelta": -20 },
        { "RuleId": "injury-doubtful", "HealthDelta": -30 },
        { "RuleId": "injury-out", "HealthDelta": -40, "RiskDelta": 25 },
        { "RuleId": "injury-ir", "HealthDelta": -45, "RiskDelta": 30 },
        { "RuleId": "injury-positive", "HealthDelta": 15 },
        { "RuleId": "injury-unconfirmed", "HealthDelta": -8, "RiskDelta": 6 },
        { "RuleId": "injury-reported", "HealthDelta": -12, "RiskDelta": 8 },
        { "RuleId": "injury-historical", "HealthDelta": -6, "RiskDelta": 8 },
        { "RuleId": "suspension", "HealthDelta": -35, "RiskDelta": 30, "OpportunityDelta": -10 },
        { "RuleId": "opportunity-start", "OpportunityDelta": 20, "UsageDelta": 10 },
        { "RuleId": "usage-first-team", "UsageDelta": 15, "OpportunityDelta": 10 },
        { "RuleId": "usage-snap", "UsageDelta": 12 },
        { "RuleId": "depth-chart", "OpportunityDelta": 8, "UsageDelta": 5 },
        { "RuleId": "transaction-signed", "OpportunityDelta": -15 },
        { "RuleId": "transaction-released", "OpportunityDelta": 12 },
        { "RuleId": "transaction-trade", "OpportunityDelta": 10, "UsageDelta": 5 },
        { "RuleId": "coaching", "UsageDelta": 10 },
        { "RuleId": "contract", "OpportunityDelta": 5 },
        { "RuleId": "weather", "RiskDelta": 8, "HealthDelta": -5 },
        { "RuleId": "practice-camp", "MomentumDelta": 5 }
      ]
    }
  },
  "QuickPicks": {
    "Scoring": {
      "MissingIntelligenceQualityFactor": 0.82,
      "MissingIntelligenceConfidencePenalty": 10,
      "PreseasonPriorProductionQualityFactor": 0.78,
      "PreseasonConfidencePenalty": 8,
      "IntelligenceConfidenceWeight": 0.35,
      "HealthScoreWeight": 1.0,
      "UsageSignalWeight": 0.55,
      "OpportunitySignalWeight": 0.45,
      "CurrentInjuryWeight": 1.0,
      "HistoricalInjuryWeight": 0.22,
      "HistoricalInjuryDecayPerYear": 0.55,
      "UnconfirmedSignalWeight": 0.28,
      "UnconfirmedConfidencePenalty": 6,
      "UnconfirmedMaxQualityDrag": 0.12,
      "MaxSingleNewsQualityDrag": 0.06,
      "NewsSignalWeight": 0.18,
      "SmallDiffScaleFraction": 0.08,
      "LowQualityDampener": 0.35,
      "LowQualityThreshold": 0.25,
      "ProbabilityEdgeScale": 28,
      "StaleConfidencePenalty": 18,
      "StaleProbabilityPenalty": 6,
      "SevereInjuryOverBiasScale": 0.85
    }
  },
  "PropLines": {
    "Provider": "Live",
    "StaleAfterMinutes": 180,
    "MaxEvents": 24,
    "MaxPlayerPropsPerEvent": 40,
    "FallbackToMockWhenEmpty": true,
    "OddsApi": {
      "BaseUrl": "https://api.the-odds-api.com/v4/",
      "ApiKey": "",
      "SportKey": "americanfootball_nfl",
      "PreseasonSportKey": "americanfootball_nfl_preseason",
      "IncludePreseasonSport": true,
      "Regions": "us",
      "GameMarkets": "h2h,spreads,totals",
      "PlayerPropMarkets": "player_pass_yds,player_rush_yds,player_reception_yds,player_receptions,player_anytime_td,player_pass_tds",
      "PreferredBookmakers": "draftkings,fanduel,betmgm,williamhill_us",
      "FetchPlayerProps": true,
      "TimeoutSeconds": 30
    }
  },
  "Projection": {
    "Rules": {
      "OpportunityVolumeFactor": 0.18,
      "UsageVolumeFactor": 0.16,
      "RecencyFactor": 0.12,
      "HealthDownsideFactor": 0.30,
      "HealthUpsideFactor": 0.06,
      "RiskDownsideFactor": 0.18,
      "TrendFactor": 0.10,
      "MomentumFactor": 0.05,
      "MatchupMaxSwing": 1.8,
      "EnvironmentMaxSwing": 1.2,
      "FloorSigmaMin": 0.10,
      "FloorSigmaMax": 0.42,
      "CeilingSigmaMin": 0.12,
      "CeilingSigmaMax": 0.48,
      "VolatilityFromLowConfidence": 0.35,
      "BaselineVolatility": 16,
      "IntelligenceConfidenceWeight": 0.55,
      "StrongRecentSampleGames": 4,
      "MinProjection": 0,
      "MaxProjection": 45
    }
  }
}
