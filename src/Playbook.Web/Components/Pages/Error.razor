@page "/Error"
@attribute [ExcludeFromInteractiveRouting]
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@layout Layout.PublicLayout
@using System.Diagnostics
@using Microsoft.Extensions.Options
@using Playbook.Application.Access
@inject IOptions<AccessOptions> Access

<PageTitle>Something went wrong — Playbook</PageTitle>
<HeadContent><meta name="robots" content="noindex" /></HeadContent>

<section class="pub-section pub-narrow">
    <h1>Something went wrong</h1>
    <p>
        Playbook hit an unexpected problem. It's been logged and we'll look into it.
        Try again in a moment — <a href="/dashboard" data-enhance-nav="false">back to the app</a>.
    </p>
    @if (!string.IsNullOrEmpty(RequestId))
    {
        <p class="pub-fine">
            Reference: <code>@RequestId</code>
            @if (!string.IsNullOrWhiteSpace(Access.Value.SupportEmail))
            {
                <text> — include this if you <a href="mailto:@Access.Value.SupportEmail">contact support</a>.</text>
            }
        </p>
    }
</section>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
