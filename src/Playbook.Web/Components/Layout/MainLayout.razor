@inherits LayoutComponentBase
@using Playbook.Application.Leagues
@using Playbook.Web.Features.Players.Components

<div class="app-shell @(sidebarOpen ? "sidebar-open" : null)">
    <div class="app-sidebar-backdrop" @onclick="CloseSidebar"></div>

    <aside class="app-sidebar">
        <div class="app-sidebar__brand">
            <span class="app-sidebar__mark">PB</span>
            <span class="app-sidebar__name">Playbook</span>
        </div>

        <NavMenu OnNavigate="CloseSidebar" />

        <div class="app-sidebar__footer">
            <a href="/terms" target="_blank" rel="noopener">Terms</a> ·
            <a href="/privacy" target="_blank" rel="noopener">Privacy</a>
            <div>@AppInfo.FooterLabel</div>
        </div>
    </aside>

    <TopBar OnMenuToggle="ToggleSidebar" />

    <main class="app-main">
        @Body
    </main>
</div>

<PlayerOverlay />

<div id="blazor-error-ui" data-nosnippet>
    Something went wrong. Your data is safe.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@inject ILeagueState LeagueState

@code {
    private bool sidebarOpen;

    // Brings back this customer's saved Sleeper leagues (their ids are stored per user) as soon
    // as their session starts; failures are silent and leave the league unconnected.
    protected override async Task OnInitializedAsync() => await LeagueState.RestoreSavedLeaguesAsync();

    private void ToggleSidebar() => sidebarOpen = !sidebarOpen;

    private void CloseSidebar() => sidebarOpen = false;
}
