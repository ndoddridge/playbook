@implements IDisposable

<header class="app-topbar">
    <div class="app-topbar__left">
        <button type="button"
                class="app-topbar__menu"
                aria-label="Toggle navigation"
                @onclick="OnMenuToggle">
            ☰
        </button>

        <div class="app-topbar__item">
            <span class="app-topbar__label">Current League</span>
            <span class="app-topbar__value">@CurrentLeague</span>
        </div>

        <span class="app-topbar__divider" aria-hidden="true"></span>

        <div class="app-topbar__item">
            <span class="app-topbar__label">Sync Status</span>
            <span class="app-topbar__value">
                <span class="pb-badge pb-badge--warning">
                    <span class="pb-dot" aria-hidden="true"></span>
                    @SyncStatus
                </span>
            </span>
        </div>
    </div>

    <div class="app-topbar__right">
        <div class="app-topbar__item app-topbar__item--time">
            <span class="app-topbar__label">Current Time</span>
            <span class="app-topbar__value app-topbar__time">@currentTime</span>
        </div>

        <span class="app-topbar__divider" aria-hidden="true"></span>

        <div class="app-topbar__profile-slot"
             title="Profile controls coming soon"
             aria-label="Profile controls reserved"></div>
    </div>
</header>

@code {
    [Parameter]
    public EventCallback OnMenuToggle { get; set; }

    private const string CurrentLeague = "No League Selected";
    private const string SyncStatus = "Offline";

    private string currentTime = DateTime.Now.ToString("h:mm:ss tt");
    private PeriodicTimer? timer;
    private CancellationTokenSource? cts;

    protected override void OnInitialized()
    {
        cts = new CancellationTokenSource();
        _ = RunClockAsync(cts.Token);
    }

    private async Task RunClockAsync(CancellationToken cancellationToken)
    {
        timer = new PeriodicTimer(TimeSpan.FromSeconds(1));

        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                currentTime = DateTime.Now.ToString("h:mm:ss tt");
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // Layout disposed.
        }
    }

    public void Dispose()
    {
        cts?.Cancel();
        cts?.Dispose();
        timer?.Dispose();
    }
}
