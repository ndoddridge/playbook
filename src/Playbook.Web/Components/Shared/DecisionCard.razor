@using Playbook.Application.Players
@using Playbook.Core.Recommendations
@inject IPlayerOverlayState PlayerOverlay

<article class="decision-card @RecommendationPresentation.ActionCss(Recommendation.ActionType) @(expanded ? "is-expanded" : null)">
    <button type="button"
            class="decision-card__main"
            aria-expanded="@expanded"
            @onclick="Toggle">
        <div class="decision-card__accent" aria-hidden="true"></div>

        <div class="decision-card__body">
            <div class="decision-card__topline">
                <span class="decision-action">
                    <span class="decision-action__icon" aria-hidden="true">@RecommendationPresentation.ActionIcon(Recommendation.ActionType)</span>
                    <span class="decision-action__label">@RecommendationPresentation.ActionLabel(Recommendation.ActionType)</span>
                </span>

                <span class="decision-priority @RecommendationPresentation.PriorityCss(Recommendation.Priority)">
                    @RecommendationPresentation.PriorityLabel(Recommendation.Priority)
                </span>

                <span class="decision-confidence">@RecommendationPresentation.ConfidenceLabel(Recommendation.Confidence)</span>
            </div>

            <h3 class="decision-card__title">
                @if (Recommendation.RelatedPlayerId is Guid playerId)
                {
                    <button type="button"
                            class="player-link"
                            @onclick="() => OpenPlayer(playerId)"
                            @onclick:stopPropagation="true">
                        @Recommendation.Title
                    </button>
                }
                else
                {
                    @Recommendation.Title
                }
            </h3>
            <p class="decision-card__summary">@Recommendation.Summary</p>

            <div class="decision-card__meta">
                <span class="decision-meta">
                    <span class="decision-meta__label">Impact</span>
                    <span class="decision-meta__value">@Recommendation.Impact</span>
                </span>
                <span class="decision-meta">
                    <span class="decision-meta__label">Status</span>
                    <span class="decision-meta__value">@RecommendationPresentation.StatusLabel(Recommendation.Status)</span>
                </span>
                <span class="decision-meta">
                    <span class="decision-meta__label">Category</span>
                    <span class="decision-meta__value">@RecommendationPresentation.CategoryLabel(Recommendation.Category)</span>
                </span>
                <span class="decision-meta">
                    <span class="decision-meta__label">Updated</span>
                    <span class="decision-meta__value">@RecommendationPresentation.TimestampLabel(Recommendation.LastUpdated)</span>
                </span>
            </div>
        </div>

        <span class="decision-card__chevron" aria-hidden="true">@(expanded ? "▴" : "▾")</span>
    </button>

    @if (expanded)
    {
        <div class="decision-card__details">
            <section class="decision-detail">
                <h4 class="decision-detail__title">Reasoning</h4>
                <p class="decision-detail__text">@Recommendation.Reasoning</p>
            </section>

            <section class="decision-detail">
                <h4 class="decision-detail__title">Supporting Signals</h4>
                <ul class="decision-detail__list">
                    @foreach (var signal in Recommendation.SupportingSignals)
                    {
                        <li>@signal</li>
                    }
                </ul>
            </section>

            <section class="decision-detail">
                <h4 class="decision-detail__title">Evidence</h4>
                <ul class="decision-detail__list">
                    @foreach (var item in Recommendation.Evidence)
                    {
                        <li>@item</li>
                    }
                </ul>
            </section>

            @if (!string.IsNullOrWhiteSpace(Recommendation.FutureNotes))
            {
                <section class="decision-detail">
                    <h4 class="decision-detail__title">Future Notes</h4>
                    <p class="decision-detail__text">@Recommendation.FutureNotes</p>
                </section>
            }
        </div>
    }
</article>

@code {
    [Parameter, EditorRequired]
    public Recommendation Recommendation { get; set; } = default!;

    private bool expanded;

    protected override void OnInitialized()
    {
        expanded = Recommendation.IsExpanded;
    }

    private void Toggle() => expanded = !expanded;

    private void OpenPlayer(Guid playerId) => PlayerOverlay.Open(playerId);
}
