@using Playbook.Core.Predictions
@using Playbook.Web.Features.QuickPicks.Models

<article class="qp-card">
    <header class="qp-card__header">
        <div class="qp-card__identity">
            <h3 class="qp-card__subject">@Prediction.SubjectLabel</h3>
            <p class="qp-card__context">@QuickPickDisplay.CompactContext(Prediction)</p>
            <p class="qp-card__source">@QuickPickDisplay.SourceLine(Prediction)</p>
        </div>
        <span class="@QuickPickDisplay.FreshnessCss(Prediction.LineFreshness)">
            @QuickPickDisplay.FreshnessLabel(Prediction.LineFreshness)
        </span>
    </header>

    <div class="qp-card__pick-row">
        <div class="qp-card__market-block">
            <span class="qp-card__market-name">@Prediction.MarketLabel</span>
            <span class="qp-card__direction">@QuickPickDisplay.LineText(Prediction)</span>
        </div>
        <div class="qp-card__confidence">
            <span class="qp-card__confidence-label">Confidence</span>
            <span class="qp-card__confidence-value">@Prediction.Confidence%</span>
        </div>
    </div>

    <div class="qp-card__stats">
        <div class="qp-stat">
            <span class="qp-stat__label">Line</span>
            <span class="qp-stat__value">@(Prediction.Line?.ToString("0.0") ?? "—")</span>
        </div>
        <div class="qp-stat">
            <span class="qp-stat__label">Playbook</span>
            <span class="qp-stat__value">@QuickPickDisplay.ProjectionText(Prediction)</span>
        </div>
        <div class="qp-stat">
            <span class="qp-stat__label">Edge</span>
            <span class="qp-stat__value qp-stat__value--edge">@QuickPickDisplay.EdgeText(Prediction)</span>
        </div>
    </div>

    <p class="qp-card__summary">@QuickPickDisplay.ShortSummary(Prediction)</p>

    <button type="button"
            class="qp-card__expand"
            @onclick="Toggle"
            aria-expanded="@expanded">
        @(expanded ? "Hide analysis" : "Why?")
    </button>

    @if (expanded)
    {
        <div class="qp-card__details">
            @foreach (var detail in detailSections)
            {
                <div class="qp-card__detail-section">
                    <h4 class="qp-card__detail-title">@detail.Title</h4>
                    <ul class="qp-card__detail-list">
                        @foreach (var item in detail.Items)
                        {
                            <li>@item</li>
                        }
                    </ul>
                </div>
            }
        </div>
    }
</article>

@code {
    [Parameter, EditorRequired]
    public Prediction Prediction { get; set; } = default!;

    private bool expanded;
    private IReadOnlyList<QuickPickDisplay.DetailSection> detailSections = [];

    protected override void OnParametersSet()
    {
        detailSections = QuickPickDisplay.BuildDetailSections(Prediction);
    }

    private void Toggle() => expanded = !expanded;
}
