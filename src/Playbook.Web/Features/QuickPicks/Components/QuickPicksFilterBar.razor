@using Playbook.Core.Predictions
@using Playbook.Web.Features.QuickPicks.Models

<div class="qp-filters">
    <div class="qp-filters__search">
        <label class="qp-filters__label" for="qp-search">Search</label>
        <input id="qp-search"
               class="qp-filters__input"
               type="search"
               placeholder="Team, player, matchup…"
               value="@Filters.Search"
               @oninput="OnSearch" />
    </div>

    <div class="qp-filters__field">
        <label class="qp-filters__label" for="qp-market">Market</label>
        <select id="qp-market" class="qp-filters__select" value="@MarketValue" @onchange="OnMarket">
            <option value="">All markets</option>
            <option value="@((int)PredictionMarketType.PassingYards)">Passing Yards</option>
            <option value="@((int)PredictionMarketType.RushingYards)">Rushing Yards</option>
            <option value="@((int)PredictionMarketType.ReceivingYards)">Receiving Yards</option>
            <option value="@((int)PredictionMarketType.Receptions)">Receptions</option>
            <option value="@((int)PredictionMarketType.AnytimeTouchdown)">Anytime TD</option>
            <option value="@((int)PredictionMarketType.PassingTouchdowns)">Pass TDs</option>
            <option value="@((int)PredictionMarketType.GameTotal)">Game Total</option>
            <option value="@((int)PredictionMarketType.Spread)">Spread</option>
            <option value="@((int)PredictionMarketType.Winner)">Moneyline</option>
        </select>
    </div>

    <div class="qp-filters__field">
        <label class="qp-filters__label" for="qp-direction">Side</label>
        <select id="qp-direction" class="qp-filters__select" value="@DirectionValue" @onchange="OnDirection">
            <option value="">Any side</option>
            <option value="@((int)PredictionDirection.Over)">Over</option>
            <option value="@((int)PredictionDirection.Under)">Under</option>
            <option value="@((int)PredictionDirection.Yes)">Yes</option>
            <option value="@((int)PredictionDirection.No)">No</option>
        </select>
    </div>

    <div class="qp-filters__field">
        <label class="qp-filters__label" for="qp-confidence">Confidence</label>
        <select id="qp-confidence" class="qp-filters__select" value="@Filters.MinConfidence" @onchange="OnConfidence">
            <option value="0">Any</option>
            <option value="40">40%+</option>
            <option value="55">55%+</option>
            <option value="70">70%+</option>
        </select>
    </div>

    <div class="qp-filters__toggle">
        <button type="button"
                class="qp-filters__mode @(Filters.StrongestOnly ? "qp-filters__mode--active" : null)"
                @onclick="() => SetStrongest(true)">
            Strongest
        </button>
        <button type="button"
                class="qp-filters__mode @(!Filters.StrongestOnly ? "qp-filters__mode--active" : null)"
                @onclick="() => SetStrongest(false)">
            All props
        </button>
    </div>

    @if (Filters.HasActiveFilters || !Filters.StrongestOnly)
    {
        <button type="button" class="qp-filters__clear" @onclick="Clear">Clear</button>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public QuickPickFilters Filters { get; set; } = default!;

    [Parameter]
    public EventCallback FiltersChanged { get; set; }

    private string MarketValue => Filters.Market is null ? "" : ((int)Filters.Market).ToString();
    private string DirectionValue => Filters.Direction is null ? "" : ((int)Filters.Direction).ToString();

    private async Task OnSearch(ChangeEventArgs e)
    {
        Filters.Search = e.Value?.ToString() ?? "";
        await FiltersChanged.InvokeAsync();
    }

    private async Task OnMarket(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString();
        Filters.Market = int.TryParse(raw, out var v) ? (PredictionMarketType)v : null;
        await FiltersChanged.InvokeAsync();
    }

    private async Task OnDirection(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString();
        Filters.Direction = int.TryParse(raw, out var v) ? (PredictionDirection)v : null;
        await FiltersChanged.InvokeAsync();
    }

    private async Task OnConfidence(ChangeEventArgs e)
    {
        Filters.MinConfidence = int.TryParse(e.Value?.ToString(), out var v) ? v : 0;
        await FiltersChanged.InvokeAsync();
    }

    private async Task SetStrongest(bool value)
    {
        Filters.StrongestOnly = value;
        await FiltersChanged.InvokeAsync();
    }

    private async Task Clear()
    {
        Filters.Clear();
        await FiltersChanged.InvokeAsync();
    }
}
