@page "/quick-picks"
@using Playbook.Application.Predictions
@using Playbook.Core.Predictions
@using Playbook.Core.Predictions.Models
@using Playbook.Web.Features.QuickPicks.Components
@using Playbook.Web.Features.QuickPicks.Interfaces
@using Playbook.Web.Features.QuickPicks.Models
@inject IQuickPicksBoard Board
@inject IQuickPicksSyncStatus SyncStatus

<PageTitle>Quick Picks — Playbook</PageTitle>

<section class="pb-page qp-page">
    <header class="pb-page__header qp-page__header">
        <h1 class="pb-page__title">Quick Picks</h1>
        <p class="pb-page__subtitle">Playbook's strongest football predictions.</p>
        <p class="qp-page__meta">
            <span class="qp-data-badge qp-data-badge--@(dataModeCss)">@dataModeLabel</span>
            <span>@SyncStatus.PropProvider</span>
            <span>Updated @(SyncStatus.LastPredictionRun?.ToLocalTime().ToString("h:mm tt") ?? "—")</span>
        </p>
        @if (SyncStatus.UsedFallback)
        {
            <p class="qp-page__note">
                Using mock market lines
                @(SyncStatus.ApiKeyConfigured ? "(live request failed)." : "(Odds API key not configured).")
                @if (!SyncStatus.ApiKeyConfigured)
                {
                    <text> Set environment variable <code>PropLines__OddsApi__ApiKey</code>, then restart the app.</text>
                }
                else if (!string.IsNullOrWhiteSpace(SyncStatus.LastError))
                {
                    <text> @SyncStatus.LastError</text>
                }
            </p>
        }
        else if (isUnavailable)
        {
            <p class="qp-page__note">
                Live sportsbook lines are currently unavailable@(string.IsNullOrWhiteSpace(SyncStatus.LastError) ? "." : $": {SyncStatus.LastError}")
                Mock lines are disabled in production, so no picks are shown rather than presenting mock data as real.
            </p>
        }
        else if (!SyncStatus.ConfiguredPrimaryBookmakerActive && SyncStatus.ProviderStatus == "Live")
        {
            <p class="qp-page__note">
                @SyncStatus.ConfiguredPrimaryBookmaker is configured as the primary source but did not have a
                line in this sync — using the next available legitimate book instead (@SyncStatus.ActiveBookmakerSummary).
                Every pick still shows its actual bookmaker and timestamp.
            </p>
        }
    </header>

    @if (selected is not null && canonicalWeeks.Count > 0)
    {
        <SlateNavigator Selected="selected"
                        CanonicalWeeks="canonicalWeeks"
                        MarketWeeks="marketWeeks"
                        OnSelected="OnSlateSelected" />
    }
    else
    {
        <p class="pb-empty">NFL slate context is not available yet.</p>
    }

    <QuickPicksFilterBar Filters="filters" FiltersChanged="OnFiltersChanged" />

    @if (filters.StrongestOnly)
    {
        <section class="qp-section" aria-labelledby="qp-top-heading">
            <div class="qp-section__heading">
                <h2 id="qp-top-heading" class="qp-section__title">Top Picks</h2>
                <label class="qp-top-count">
                    <span class="qp-top-count__label">Show</span>
                    <select class="qp-top-count__select"
                            value="@topCount"
                            @onchange="OnTopCountChanged"
                            aria-label="Number of top picks">
                        @for (var n = 1; n <= 20; n++)
                        {
                            <option value="@n">@n</option>
                        }
                    </select>
                </label>
            </div>
            <p class="qp-section__subtitle">@topSubtitle@(selected is null ? "" : $" · {selected.DisplayLabel}")</p>
            @if (visibleTop.Count == 0)
            {
                <p class="pb-empty">@EmptyBoardMessage()</p>
            }
            else
            {
                <div class="qp-grid">
                    @foreach (var pick in visibleTop)
                    {
                        <PredictionCard @key="pick.Id" Prediction="pick" />
                    }
                </div>
            }
        </section>

        <section class="qp-section" aria-labelledby="qp-watch-heading">
            <h2 id="qp-watch-heading" class="qp-section__title">Watch</h2>
            <p class="qp-section__subtitle">Interesting but weaker opportunities than Top Picks</p>
            @if (visibleWatch.Count == 0)
            {
                <p class="pb-empty">No additional watch-list opportunities for this filter.</p>
            }
            else
            {
                <div class="qp-grid">
                    @foreach (var pick in visibleWatch)
                    {
                        <PredictionCard @key="pick.Id" Prediction="pick" />
                    }
                </div>
            }
        </section>
    }
    else
    {
        <section class="qp-section" aria-labelledby="qp-all-heading">
            <h2 id="qp-all-heading" class="qp-section__title">All Props</h2>
            <p class="qp-section__subtitle">Every evaluated opportunity on this slate</p>
            @if (visibleAll.Count == 0)
            {
                <p class="pb-empty">No props match this filter on the selected slate.</p>
            }
            else
            {
                <div class="qp-grid">
                    @foreach (var pick in visibleAll)
                    {
                        <PredictionCard @key="pick.Id" Prediction="pick" />
                    }
                </div>
            }
        </section>
    }

    <section class="qp-section" aria-labelledby="qp-upcoming-heading">
        <h2 id="qp-upcoming-heading" class="qp-section__title">Games</h2>
        <p class="qp-section__subtitle">Matchups on this slate</p>
        @if (events.Count == 0)
        {
            <p class="pb-empty">No games loaded for this slate.</p>
        }
        else
        {
            <ul class="qp-upcoming">
                @foreach (var ev in events)
                {
                    <li>
                        <span class="qp-upcoming__match">@ev.DisplayName</span>
                        <span class="qp-upcoming__time">@ev.SlateLabel · @ev.CommenceTime.ToLocalTime().ToString("ddd h:mm tt")</span>
                    </li>
                }
            </ul>
        }
    </section>
</section>

@code {
    private const int WatchCount = 8;

    private readonly QuickPickFilters filters = new();
    private IReadOnlyList<NflWeekRef> canonicalWeeks = [];
    private IReadOnlyList<NflWeekRef> marketWeeks = [];
    private NflWeekRef? selected;
    private IReadOnlyList<Prediction> slatePredictions = [];
    private IReadOnlyList<Prediction> visibleTop = [];
    private IReadOnlyList<Prediction> visibleWatch = [];
    private IReadOnlyList<Prediction> visibleAll = [];
    private IReadOnlyList<FootballEvent> events = [];
    private string dataModeLabel = "MOCK DATA";
    private string dataModeCss = "mock";
    private bool isUnavailable;
    private string topSubtitle = "Best available opportunities";

    /// <summary>Persists for the Blazor Server circuit / session.</summary>
    private int topCount = 5;

    protected override void OnInitialized() => ReloadFromBoard();

    private void ReloadFromBoard()
    {
        canonicalWeeks = Board.CanonicalWeeks;
        marketWeeks = Board.AvailableWeeks;
        selected = Board.SelectedWeek;
        slatePredictions = Board.SlatePredictions;
        events = Board.Upcoming;
        ApplyFilters();

        var isLive = string.Equals(SyncStatus.ProviderStatus, "Live", StringComparison.OrdinalIgnoreCase)
                     && !SyncStatus.UsedFallback;
        isUnavailable = !isLive && !SyncStatus.UsedFallback &&
                        string.Equals(SyncStatus.ProviderStatus, "Error", StringComparison.OrdinalIgnoreCase);

        dataModeLabel = isLive ? "LIVE DATA"
            : SyncStatus.UsedFallback ? "MOCK FALLBACK"
            : isUnavailable ? "LIVE UNAVAILABLE"
            : "MOCK DATA";
        dataModeCss = isLive ? "live"
            : SyncStatus.UsedFallback ? "fallback"
            : isUnavailable ? "unavailable"
            : "mock";
    }

    private void OnSlateSelected(NflWeekRef slate)
    {
        if (Board.TrySelectWeek(slate))
        {
            ReloadFromBoard();
        }
    }

    private void OnFiltersChanged() => ApplyFilters();

    private void OnTopCountChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var n))
        {
            topCount = Math.Clamp(n, 1, 20);
            ApplyFilters();
        }
    }

    /// <summary>
    /// Explain an empty board from what the slate actually contained. Real game lines that
    /// Playbook declined to evaluate must not be reported as "no eligible props".
    /// </summary>
    private string EmptyBoardMessage()
    {
        var (gameLines, propLines) = Board.GetSlateMarketCounts();

        // The betting gate is read from the model itself, not guessed from an empty list, so
        // "betting is switched off" and "nothing cleared the thresholds" stay distinguishable.
        var reason = QuickPicksEmptyState.Classify(
            gameLines,
            propLines,
            slatePredictions.Count,
            TeamPointsModel.GameMarketBettingEnabled);

        return QuickPicksEmptyState.Describe(reason, gameLines, propLines);
    }

    private void ApplyFilters()
    {
        // Filter → strength-rank → diverse Top selection. Near-duplicates fall through to Watch.
        var ranked = filters.RankEligible(slatePredictions);
        visibleTop = filters.SelectDiverseTop(slatePredictions, topCount);
        var topIds = visibleTop.Select(p => p.Id).ToHashSet();
        visibleWatch = ranked.Where(p => !topIds.Contains(p.Id)).Take(WatchCount).ToList();
        visibleAll = filters.Apply(slatePredictions)
            .OrderByDescending(p => p.OpportunityScore)
            .ThenByDescending(p => p.Edge)
            .ThenByDescending(p => p.Confidence)
            .ToList();

        topSubtitle = visibleTop.Count > 0 && visibleTop.Any(p => p.Confidence >= 55)
            ? "Strongest opportunities"
            : "Best available opportunities";
    }
}
