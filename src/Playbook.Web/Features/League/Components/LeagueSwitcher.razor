@using Playbook.Application.Leagues
@using Playbook.Core.Leagues
@using Playbook.Web.Features.League.Models
@inject ILeagueState LeagueState
@inject ILeagueSyncStatus LeagueSyncStatus
@implements IDisposable

<div class="league-switcher" @onclick:stopPropagation="true">
    <button type="button"
            class="league-switcher__trigger"
            aria-haspopup="listbox"
            aria-expanded="@isOpen"
            @onclick="Toggle">
        <span class="app-topbar__item">
            <span class="app-topbar__label">Current League</span>
            <span class="app-topbar__value league-switcher__value">
                @(LeagueState.CurrentLeague?.Name ?? "No League Selected")
                @if (LeagueState.CurrentLeague is { } current)
                {
                    <span class="league-source-badge @(LeagueDisplay.IsLive(current) ? "league-source-badge--live" : "league-source-badge--mock")">
                        @(LeagueDisplay.IsLive(current) ? "Live" : "Mock")
                    </span>
                }
                <span class="league-switcher__caret" aria-hidden="true">▾</span>
            </span>
        </span>
    </button>

    @if (isOpen)
    {
        <div class="league-switcher__menu" role="listbox" aria-label="Select league">
            @foreach (var league in LeagueState.GetAllLeagues())
            {
                var isSelected = league.Id == LeagueState.CurrentLeague?.Id;
                <button type="button"
                        class="league-switcher__option @(isSelected ? "is-selected" : null)"
                        role="option"
                        aria-selected="@isSelected"
                        @onclick="() => Select(league)">
                    <span class="league-switcher__option-name">
                        @league.Name
                        <span class="league-source-badge @(LeagueDisplay.IsLive(league) ? "league-source-badge--live" : "league-source-badge--mock")">
                            @(LeagueDisplay.IsLive(league) ? "Live" : "Mock")
                        </span>
                    </span>
                    <span class="league-switcher__option-meta">
                        @LeagueDisplay.Platform(league.Platform) · @LeagueDisplay.LeagueType(league.LeagueType) · @LeagueDisplay.ScoringDetailed(league)
                        @if (!string.IsNullOrWhiteSpace(league.ExternalId))
                        {
                            <text> · @league.ExternalId</text>
                        }
                    </span>
                </button>
            }

            <div class="league-switcher__connect">
                <label class="league-switcher__connect-label" for="sleeper-league-id">Connect Sleeper league</label>
                <div class="league-switcher__connect-row">
                    <input id="sleeper-league-id"
                           class="league-switcher__connect-input"
                           type="text"
                           inputmode="numeric"
                           placeholder="Sleeper league ID"
                           @bind="sleeperLeagueId"
                           @bind:event="oninput"
                           disabled="@isConnecting" />
                    <button type="button"
                            class="league-switcher__connect-button"
                            disabled="@(isConnecting || string.IsNullOrWhiteSpace(sleeperLeagueId))"
                            @onclick="ConnectAsync">
                        @(isConnecting ? "Connecting…" : "Connect")
                    </button>
                </div>
                @if (!string.IsNullOrWhiteSpace(connectMessage))
                {
                    <p class="league-switcher__connect-message @(connectSucceeded ? "is-success" : "is-error")">
                        @connectMessage
                    </p>
                }
                else if (!string.IsNullOrWhiteSpace(LeagueSyncStatus.LastError) && !connectSucceeded)
                {
                    <p class="league-switcher__connect-message is-error">@LeagueSyncStatus.LastError</p>
                }
            </div>
        </div>
    }
</div>

@code {
    private bool isOpen;
    private bool isConnecting;
    private bool connectSucceeded;
    private string sleeperLeagueId = string.Empty;
    private string? connectMessage;

    protected override void OnInitialized()
    {
        LeagueState.Changed += OnLeagueChanged;
    }

    private void Toggle() => isOpen = !isOpen;

    private void Select(League league)
    {
        LeagueState.SelectLeague(league.Id);
        isOpen = false;
    }

    private async Task ConnectAsync()
    {
        isConnecting = true;
        connectMessage = null;
        connectSucceeded = false;
        try
        {
            var result = await LeagueState.ConnectSleeperLeagueAsync(sleeperLeagueId);
            if (result.Succeeded && result.League is not null)
            {
                connectSucceeded = true;
                connectMessage =
                    $"Loaded {result.League.Name} ({result.Teams.Count} teams, {LeagueDisplay.ScoringDetailed(result.League)}).";
                sleeperLeagueId = string.Empty;
            }
            else
            {
                connectMessage = result.Error ?? "Could not connect to that Sleeper league.";
            }
        }
        catch (Exception)
        {
            connectMessage = "Could not reach Sleeper. Check the league ID and try again.";
        }
        finally
        {
            isConnecting = false;
        }
    }

    private void OnLeagueChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => LeagueState.Changed -= OnLeagueChanged;
}
