@using Playbook.Application.Intelligence.Interfaces
@using Playbook.Application.News
@using Playbook.Application.Players
@using Playbook.Application.Projections.Interfaces
@using Playbook.Application.Stats
@using Playbook.Application.Stats.Interfaces
@using Playbook.Core.Intelligence.Models
@using Playbook.Core.Leagues
@using Playbook.Core.News
@using Playbook.Core.Players
@using Playbook.Core.Projections.Models
@using Playbook.Core.Stats.Models
@using Playbook.Web.Features.Intelligence.Models
@using Playbook.Web.Features.News.Models
@using Playbook.Web.Features.Projections.Models
@inject IPlayerOverlayState Overlay
@inject IIntelligenceService IntelligenceService
@inject IProjectionService ProjectionService
@inject IPlayerStatsService PlayerStatsService
@inject INewsProvider NewsProvider
@implements IDisposable

@if (Overlay.IsOpen && Overlay.Context is { } context)
{
    var player = context.Player;

    <div class="player-overlay" role="dialog" aria-modal="true" aria-label="@player.FullName">
        <div class="player-overlay__backdrop" @onclick="Close"></div>

        <div class="player-overlay__panel" @onclick:stopPropagation="true">
            <header class="player-overlay__header">
                <div class="player-overlay__identity">
                    <div class="player-avatar player-avatar--lg" aria-hidden="true">
                        @PlayerPresentation.Initials(player)
                    </div>
                    <div>
                        <h2 class="player-overlay__name">@player.FullName</h2>
                        <p class="player-overlay__meta">
                            @PlayerPresentation.PositionLabel(player.Position) · @player.Team
                            @if (player.JerseyNumber is int number)
                            {
                                <text> · #@number</text>
                            }
                            · @PlayerPresentation.StatusLabel(player.Status)
                        </p>
                        <p class="player-overlay__league">
                            @(context.League?.Name ?? "No League Selected")
                            · @FormatScoring(context.ScoringType)
                        </p>
                    </div>
                </div>

                <button type="button" class="player-overlay__close" aria-label="Close player overlay" @onclick="Close">
                    ✕
                </button>
            </header>

            <nav class="player-overlay__tabs" aria-label="Player sections">
                @foreach (var tab in Tabs)
                {
                    <button type="button"
                            class="player-overlay__tab @(activeTab == tab ? "is-active" : null)"
                            @onclick="() => SelectTab(tab)">
                        @tab
                    </button>
                }
            </nav>

            <div class="player-overlay__body">
                @if (activeTab == "Overview")
                {
                    <section class="player-section">
                        <h3 class="player-section__title">Overview</h3>
                        <div class="player-profile__grid">
                            <div class="player-stat">
                                <span class="player-stat__label">Years Pro</span>
                                <span class="player-stat__value">@(player.YearsPro?.ToString() ?? "—")</span>
                            </div>
                            <div class="player-stat">
                                <span class="player-stat__label">College</span>
                                <span class="player-stat__value">@(player.College ?? "—")</span>
                            </div>
                            <div class="player-stat">
                                <span class="player-stat__label">Age</span>
                                <span class="player-stat__value">@(player.Age?.ToString() ?? "—")</span>
                            </div>
                            <div class="player-stat">
                                <span class="player-stat__label">Bye</span>
                                <span class="player-stat__value">@(player.ByeWeek?.ToString() ?? "—")</span>
                            </div>
                        </div>
                        @if (context.Profile?.Trend is { } trend)
                        {
                            <p class="player-section__text" style="margin-top:1rem;">
                                @PlayerPresentation.TrendLabel(trend.Direction) — @trend.Label
                            </p>
                        }

                        <h3 class="player-section__title" style="margin-top:1.5rem;">Recent News</h3>
                        @if (playerNews.Count > 0)
                        {
                            <div class="player-news-list">
                                @foreach (var article in playerNews)
                                {
                                    <article class="news-item">
                                        <div class="news-item__header">
                                            <h4 class="news-item__title">
                                                @if (!string.IsNullOrWhiteSpace(article.Url))
                                                {
                                                    <a href="@article.Url" target="_blank" rel="noopener noreferrer">@article.Title</a>
                                                }
                                                else
                                                {
                                                    @article.Title
                                                }
                                            </h4>
                                            <span class="@NewsPresentation.PriorityClass(article.Priority)">
                                                @NewsPresentation.Priority(article.Priority)
                                            </span>
                                        </div>
                                        <p class="news-item__summary">@article.Summary</p>
                                        <div class="news-item__meta">
                                            <span>@NewsPresentation.RelativeTime(article.Published)</span>
                                            <span>@article.Source</span>
                                        </div>
                                    </article>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="player-section__muted">No related news for this player right now.</p>
                        }
                    </section>
                }
                else if (activeTab == "Fantasy")
                {
                    <section class="player-section">
                        <h3 class="player-section__title">Fantasy Context</h3>
                        <div class="player-profile__grid">
                            <div class="player-stat">
                                <span class="player-stat__label">Weekly Projection</span>
                                <span class="player-stat__value">@context.WeeklyProjection.ToString("0.0")</span>
                            </div>
                            <div class="player-stat">
                                <span class="player-stat__label">ROS Rank</span>
                                <span class="player-stat__value">#@context.RestOfSeasonRank</span>
                            </div>
                            <div class="player-stat">
                                <span class="player-stat__label">Positional Rank</span>
                                <span class="player-stat__value">@PlayerPresentation.PositionLabel(player.Position)@context.PositionalRank</span>
                            </div>
                            <div class="player-stat">
                                <span class="player-stat__label">VORP</span>
                                <span class="player-stat__value">@context.ValueOverReplacement.ToString("+0.0;-0.0")</span>
                            </div>
                            <div class="player-stat">
                                <span class="player-stat__label">Confidence</span>
                                <span class="player-stat__value">@context.Confidence%</span>
                            </div>
                        </div>
                        <p class="player-section__text" style="margin-top:1rem;">@context.RecommendationSummary</p>
                    </section>
                }
                else if (activeTab == "Projection")
                {
                    <section class="player-section">
                        <h3 class="player-section__title">Player Projection</h3>
                        @if (playerProjection is null)
                        {
                            <p class="player-section__muted">No projection available for this player yet.</p>
                        }
                        else
                        {
                            <div class="player-profile__grid" style="margin-bottom:1rem;">
                                <div class="player-stat">
                                    <span class="player-stat__label">Projected Points</span>
                                    <span class="player-stat__value">@ProjectionPresentation.Points(playerProjection.ProjectedFantasyPoints)</span>
                                </div>
                                <div class="player-stat">
                                    <span class="player-stat__label">Floor</span>
                                    <span class="player-stat__value">@ProjectionPresentation.Points(playerProjection.Floor)</span>
                                </div>
                                <div class="player-stat">
                                    <span class="player-stat__label">Median</span>
                                    <span class="player-stat__value">@ProjectionPresentation.Points(playerProjection.Median)</span>
                                </div>
                                <div class="player-stat">
                                    <span class="player-stat__label">Ceiling</span>
                                    <span class="player-stat__value">@ProjectionPresentation.Points(playerProjection.Ceiling)</span>
                                </div>
                                <div class="player-stat">
                                    <span class="player-stat__label">Confidence</span>
                                    <span class="player-stat__value">@ProjectionPresentation.Percent(playerProjection.Confidence)</span>
                                </div>
                                <div class="player-stat">
                                    <span class="player-stat__label">Volatility</span>
                                    <span class="player-stat__value">@playerProjection.Volatility</span>
                                </div>
                            </div>

                            <p class="player-section__muted" style="margin-bottom:1rem;">
                                Updated @ProjectionPresentation.RelativeTime(playerProjection.LastUpdated)
                            </p>

                            <h3 class="player-section__title">Reasoning</h3>
                            <ul class="projection-reason-list">
                                @foreach (var reason in playerProjection.ProjectionReasoning)
                                {
                                    <li>@reason</li>
                                }
                            </ul>

                            <h3 class="player-section__title" style="margin-top:1.25rem;">Supporting Intelligence</h3>
                            <ul class="projection-reason-list">
                                @foreach (var item in playerProjection.SupportingIntelligence)
                                {
                                    <li>@item</li>
                                }
                            </ul>
                        }
                    </section>
                }
                else if (activeTab == "Intelligence")
                {
                    <section class="player-section">
                        <h3 class="player-section__title">Player Intelligence Profile</h3>
                        @if (playerProfile is null)
                        {
                            <p class="player-section__muted">No aggregated intelligence profile for this player yet.</p>
                        }
                        else
                        {
                            <div class="player-profile__grid" style="margin-bottom:1rem;">
                                <div class="player-stat">
                                    <span class="player-stat__label">Overall Intelligence</span>
                                    <span class="player-stat__value">@playerProfile.Headline</span>
                                </div>
                                <div class="player-stat">
                                    <span class="player-stat__label">Health</span>
                                    <span class="player-stat__value">@playerProfile.HealthScore</span>
                                </div>
                                <div class="player-stat">
                                    <span class="player-stat__label">Opportunity</span>
                                    <span class="player-stat__value">@playerProfile.OpportunityScore</span>
                                </div>
                                <div class="player-stat">
                                    <span class="player-stat__label">Usage</span>
                                    <span class="player-stat__value">@playerProfile.UsageScore</span>
                                </div>
                                <div class="player-stat">
                                    <span class="player-stat__label">Trend</span>
                                    <span class="player-stat__value">@IntelligencePresentation.TrendLabel(playerProfile.TrendDirection)</span>
                                </div>
                                <div class="player-stat">
                                    <span class="player-stat__label">Overall Confidence</span>
                                    <span class="player-stat__value">@playerProfile.OverallConfidence%</span>
                                </div>
                            </div>

                            <div class="intel-summary">
                                <div class="intel-summary__item">
                                    <span class="intel-summary__label">Risk</span>
                                    <p class="intel-summary__text">@playerProfile.OverallRisk / 100</p>
                                </div>
                                <div class="intel-summary__item">
                                    <span class="intel-summary__label">News Momentum</span>
                                    <p class="intel-summary__text">@playerProfile.NewsMomentum / 100</p>
                                </div>
                                <div class="intel-summary__item">
                                    <span class="intel-summary__label">Supporting Facts</span>
                                    <p class="intel-summary__text">@playerProfile.SupportingFacts.Count evidence items</p>
                                </div>
                            </div>

                            <h3 class="player-section__title" style="margin-top:1.25rem;">Supporting Intelligence</h3>
                            @foreach (var group in playerProfile.SupportingFacts.GroupBy(f => f.Category).OrderBy(g => g.Key))
                            {
                                <div class="intel-group">
                                    <h4 class="intel-group__title">@IntelligencePresentation.Category(group.Key)</h4>
                                    @foreach (var fact in group.OrderByDescending(f => f.Importance).ThenByDescending(f => f.Confidence))
                                    {
                                        <article class="intel-fact">
                                            <div class="intel-fact__header">
                                                <h5 class="intel-fact__title">@fact.Title</h5>
                                                <div class="intel-fact__meta">
                                                    <span>@fact.Confidence%</span>
                                                    <span class="@IntelligencePresentation.ImportanceClass(fact.Importance)">
                                                        @IntelligencePresentation.Importance(fact.Importance)
                                                    </span>
                                                </div>
                                            </div>
                                            <p class="intel-fact__description">@fact.Description</p>
                                            @{
                                                var supportArticles = NewsProvider.GetByIds(fact.RelatedNewsArticleIds);
                                            }
                                            @if (supportArticles.Count > 0)
                                            {
                                                <div class="player-news-list">
                                                    @foreach (var article in supportArticles)
                                                    {
                                                        <article class="news-item">
                                                            <h4 class="news-item__title">
                                                                @if (!string.IsNullOrWhiteSpace(article.Url))
                                                                {
                                                                    <a href="@article.Url" target="_blank" rel="noopener noreferrer">@article.Title</a>
                                                                }
                                                                else
                                                                {
                                                                    @article.Title
                                                                }
                                                            </h4>
                                                            <div class="news-item__meta">
                                                                <span>@article.Source</span>
                                                                <span>@NewsPresentation.RelativeTime(article.Published)</span>
                                                            </div>
                                                        </article>
                                                    }
                                                </div>
                                            }
                                        </article>
                                    }
                                </div>
                            }
                        }
                    </section>
                }
                else if (activeTab == "Career")
                {
                    <section class="player-section">
                        <h3 class="player-section__title">Career / Stats</h3>
                        @if (careerSeasonStats.Count == 0)
                        {
                            <p class="player-section__muted">No normalized season statistics available for this player yet.</p>
                        }
                        else
                        {
                            <label class="player-overlay__season">
                                <span class="player-overlay__season-label">Season</span>
                                <select class="player-overlay__season-select" value="@selectedStatsKey" @onchange="OnStatsSeasonChanged">
                                    @foreach (var row in careerSeasonStats)
                                    {
                                        <option value="@PlayerCareerSeasonPresentation.StatsKey(row)">
                                            @PlayerCareerSeasonPresentation.FormatSeasonOption(row)
                                        </option>
                                    }
                                </select>
                            </label>

                            @if (selectedSeasonStats is { } season)
                            {
                                @RenderSeasonDetail(season)
                            }
                        }
                    </section>
                }
                else if (activeTab == "College")
                {
                    <section class="player-section">
                        <h3 class="player-section__title">College</h3>
                        @{
                            var school = collegeSeasonStats.FirstOrDefault()?.CollegeSchool
                                ?? player.College
                                ?? context.Profile?.CollegeStats?.School;
                        }
                        @if (!string.IsNullOrWhiteSpace(school))
                        {
                            <p class="player-section__text">@school</p>
                        }

                        @if (collegeSeasonStats.Count == 0)
                        {
                            <p class="player-section__muted">No college statistics available for this player.</p>
                        }
                        else
                        {
                            <div class="player-profile__grid" style="margin:1rem 0;">
                                <div class="player-stat">
                                    <span class="player-stat__label">Seasons</span>
                                    <span class="player-stat__value">@collegeSeasonStats.Count</span>
                                </div>
                                <div class="player-stat">
                                    <span class="player-stat__label">Games</span>
                                    <span class="player-stat__value">@(SumNullable(collegeSeasonStats.Select(s => s.Games))?.ToString() ?? "—")</span>
                                </div>
                            </div>

                            <label class="player-overlay__season">
                                <span class="player-overlay__season-label">College Season</span>
                                <select class="player-overlay__season-select" value="@selectedCollegeKey" @onchange="OnCollegeSeasonChanged">
                                    @foreach (var row in collegeSeasonStats)
                                    {
                                        <option value="@PlayerCareerSeasonPresentation.StatsKey(row)">
                                            @PlayerCareerSeasonPresentation.FormatSeasonOption(row)
                                        </option>
                                    }
                                </select>
                            </label>

                            @if (selectedCollegeStats is { } collegeSeason)
                            {
                                @RenderSeasonDetail(collegeSeason)
                            }
                        }
                    </section>
                }
                else
                {
                    <section class="player-section">
                        <h3 class="player-section__title">Injuries</h3>
                        @if (context.Profile?.InjuryHistory is { Count: > 0 } injuries)
                        {
                            <ul class="player-injury-list">
                                @foreach (var injury in injuries)
                                {
                                    <li>
                                        <strong>@injury.ReportedOn.ToString("MMM d, yyyy")</strong>
                                        — @injury.Description (@injury.Status)
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p class="player-section__muted">No injury records on file.</p>
                        }
                    </section>
                }
            </div>
        </div>
    </div>
}

@code {
    private static readonly string[] Tabs = PlayerOverlayLayoutRules.Tabs;

    private string activeTab = "Overview";
    private PlayerIntelligenceProfile? playerProfile;
    private PlayerProjection? playerProjection;
    private IReadOnlyList<NewsArticle> playerNews = [];
    private IReadOnlyList<PlayerSeasonStats> allPlayerSeasonStats = [];
    private IReadOnlyList<PlayerSeasonStats> careerSeasonStats = [];
    private IReadOnlyList<PlayerSeasonStats> collegeSeasonStats = [];
    private PlayerSeasonStats? selectedSeasonStats;
    private PlayerSeasonStats? selectedCollegeStats;
    private string selectedStatsKey = string.Empty;
    private string selectedCollegeKey = string.Empty;
    private Guid? loadedPlayerId;
    private Guid? loadedProjectionPlayerId;
    private Guid? loadedNewsPlayerId;
    private Guid? loadedStatsPlayerId;
    private Guid? openPlayerId;

    protected override void OnInitialized()
    {
        Overlay.Changed += OnOverlayChanged;
    }

    private void OnOverlayChanged() => InvokeAsync(() =>
    {
        var openedPlayerId = Overlay.IsOpen ? Overlay.Context?.Player.Id : null;

        if (Overlay.IsOpen)
        {
            // Reset section state only when opening or switching players.
            // League refresh calls Changed for the same player — keep the active tab.
            if (openedPlayerId != openPlayerId)
            {
                openPlayerId = openedPlayerId;
                activeTab = "Overview";
                playerProfile = null;
                playerProjection = null;
                playerNews = [];
                allPlayerSeasonStats = [];
                careerSeasonStats = [];
                collegeSeasonStats = [];
                selectedSeasonStats = null;
                selectedCollegeStats = null;
                selectedStatsKey = string.Empty;
                selectedCollegeKey = string.Empty;
                loadedPlayerId = null;
                loadedProjectionPlayerId = null;
                loadedNewsPlayerId = null;
                loadedStatsPlayerId = null;
                EnsurePlayerNews();
            }
        }
        else
        {
            openPlayerId = null;
        }

        StateHasChanged();
    });

    private void SelectTab(string tab)
    {
        activeTab = tab;
        if (tab == "Intelligence")
        {
            EnsurePlayerProfile();
        }

        if (tab == "Projection")
        {
            EnsurePlayerProjection();
        }

        if (tab is "Career" or "College")
        {
            EnsurePlayerStats();
        }

        if (tab == "Overview")
        {
            EnsurePlayerNews();
        }
    }

    private void EnsurePlayerProfile()
    {
        if (Overlay.Context is not { } context)
        {
            return;
        }

        if (loadedPlayerId == context.Player.Id && playerProfile is not null)
        {
            return;
        }

        playerProfile = IntelligenceService.GetPlayerProfile(context.Player.Id);
        loadedPlayerId = context.Player.Id;
    }

    private void EnsurePlayerProjection()
    {
        if (Overlay.Context is not { } context)
        {
            return;
        }

        if (loadedProjectionPlayerId == context.Player.Id && playerProjection is not null)
        {
            return;
        }

        playerProjection = ProjectionService.GetProjection(context.Player.Id);
        loadedProjectionPlayerId = context.Player.Id;
    }

    private void EnsurePlayerNews()
    {
        if (Overlay.Context is not { } context)
        {
            return;
        }

        if (loadedNewsPlayerId == context.Player.Id)
        {
            return;
        }

        playerNews = NewsProvider.GetForPlayer(context.Player.Id, 6);
        loadedNewsPlayerId = context.Player.Id;
    }

    private void EnsurePlayerStats()
    {
        if (Overlay.Context is not { } context)
        {
            return;
        }

        if (loadedStatsPlayerId == context.Player.Id)
        {
            return;
        }

        allPlayerSeasonStats = PlayerStatsService.GetStatsForPlayer(context.Player.Id);
        careerSeasonStats = PlayerCareerSeasonPresentation.ForCareerSelector(
            allPlayerSeasonStats,
            context.Player.YearsPro);
        collegeSeasonStats = PlayerCareerSeasonPresentation.ForCollegeTab(allPlayerSeasonStats);

        selectedSeasonStats = careerSeasonStats.FirstOrDefault();
        selectedStatsKey = selectedSeasonStats is null
            ? string.Empty
            : PlayerCareerSeasonPresentation.StatsKey(selectedSeasonStats);

        selectedCollegeStats = collegeSeasonStats.FirstOrDefault();
        selectedCollegeKey = selectedCollegeStats is null
            ? string.Empty
            : PlayerCareerSeasonPresentation.StatsKey(selectedCollegeStats);

        loadedStatsPlayerId = context.Player.Id;
    }

    private void OnStatsSeasonChanged(ChangeEventArgs args)
    {
        selectedStatsKey = args.Value?.ToString() ?? string.Empty;
        selectedSeasonStats = careerSeasonStats
            .FirstOrDefault(r => PlayerCareerSeasonPresentation.StatsKey(r) == selectedStatsKey);
    }

    private void OnCollegeSeasonChanged(ChangeEventArgs args)
    {
        selectedCollegeKey = args.Value?.ToString() ?? string.Empty;
        selectedCollegeStats = collegeSeasonStats
            .FirstOrDefault(r => PlayerCareerSeasonPresentation.StatsKey(r) == selectedCollegeKey);
    }

    private static int? SumNullable(IEnumerable<int?> values)
    {
        var list = values.Where(v => v is not null).Select(v => v!.Value).ToList();
        return list.Count == 0 ? null : list.Sum();
    }

    private RenderFragment RenderSeasonDetail(PlayerSeasonStats season) => __builder =>
    {
        <p class="player-section__muted" style="margin-bottom:1rem;">
            @PlayerCareerSeasonPresentation.FormatPeriodLabel(season.Period)
            @if (!string.IsNullOrWhiteSpace(season.CollegeSchool))
            {
                <text> · @season.CollegeSchool</text>
            }
            @if (!string.IsNullOrWhiteSpace(season.SourceProvider))
            {
                <text> · Source @season.SourceProvider</text>
            }
        </p>
        <div class="player-profile__grid">
            <div class="player-stat">
                <span class="player-stat__label">Season</span>
                <span class="player-stat__value">@season.Season</span>
            </div>
            <div class="player-stat">
                <span class="player-stat__label">Games</span>
                <span class="player-stat__value">@(season.Games?.ToString() ?? "—")</span>
            </div>
            <div class="player-stat">
                <span class="player-stat__label">Starts</span>
                <span class="player-stat__value">@(season.Starts?.ToString() ?? "—")</span>
            </div>
            <div class="player-stat">
                <span class="player-stat__label">Fantasy (PPR)</span>
                <span class="player-stat__value">@(season.FantasyPointsPpr?.ToString("0.0") ?? "—")</span>
            </div>
            <div class="player-stat">
                <span class="player-stat__label">Fantasy (Half)</span>
                <span class="player-stat__value">@(season.FantasyPointsHalfPpr?.ToString("0.0") ?? "—")</span>
            </div>
            <div class="player-stat">
                <span class="player-stat__label">Fantasy (Std)</span>
                <span class="player-stat__value">@(season.FantasyPointsStandard?.ToString("0.0") ?? "—")</span>
            </div>
        </div>

        <div class="player-overlay__stat-block">
            <h3 class="player-section__title">Passing</h3>
            <div class="player-profile__grid">
                <div class="player-stat"><span class="player-stat__label">Att</span><span class="player-stat__value">@(season.PassAttempts?.ToString() ?? "—")</span></div>
                <div class="player-stat"><span class="player-stat__label">Cmp</span><span class="player-stat__value">@(season.PassCompletions?.ToString() ?? "—")</span></div>
                <div class="player-stat"><span class="player-stat__label">Yards</span><span class="player-stat__value">@(season.PassYards?.ToString() ?? "—")</span></div>
                <div class="player-stat"><span class="player-stat__label">TD</span><span class="player-stat__value">@(season.PassTouchdowns?.ToString() ?? "—")</span></div>
                <div class="player-stat"><span class="player-stat__label">INT</span><span class="player-stat__value">@(season.PassInterceptions?.ToString() ?? "—")</span></div>
            </div>
        </div>

        <div class="player-overlay__stat-block">
            <h3 class="player-section__title">Rushing</h3>
            <div class="player-profile__grid">
                <div class="player-stat"><span class="player-stat__label">Att</span><span class="player-stat__value">@(season.RushAttempts?.ToString() ?? "—")</span></div>
                <div class="player-stat"><span class="player-stat__label">Yards</span><span class="player-stat__value">@(season.RushYards?.ToString() ?? "—")</span></div>
                <div class="player-stat"><span class="player-stat__label">TD</span><span class="player-stat__value">@(season.RushTouchdowns?.ToString() ?? "—")</span></div>
            </div>
        </div>

        <div class="player-overlay__stat-block">
            <h3 class="player-section__title">Receiving</h3>
            <div class="player-profile__grid">
                <div class="player-stat"><span class="player-stat__label">Targets</span><span class="player-stat__value">@(season.Targets?.ToString() ?? "—")</span></div>
                <div class="player-stat"><span class="player-stat__label">Receptions</span><span class="player-stat__value">@(season.Receptions?.ToString() ?? "—")</span></div>
                <div class="player-stat"><span class="player-stat__label">Yards</span><span class="player-stat__value">@(season.ReceivingYards?.ToString() ?? "—")</span></div>
                <div class="player-stat"><span class="player-stat__label">TD</span><span class="player-stat__value">@(season.ReceivingTouchdowns?.ToString() ?? "—")</span></div>
            </div>
        </div>
    };

    private void Close() => Overlay.Close();

    private static string FormatScoring(ScoringType scoring) => scoring switch
    {
        ScoringType.Ppr => "PPR",
        ScoringType.HalfPpr => "Half PPR",
        ScoringType.Standard => "Standard",
        _ => scoring.ToString()
    };

    public void Dispose() => Overlay.Changed -= OnOverlayChanged;
}
