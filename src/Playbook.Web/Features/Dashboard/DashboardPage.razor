@page "/"
@using Playbook.Application.Intelligence.Interfaces
@using Playbook.Application.Leagues
@using Playbook.Application.Recommendations
@using Playbook.Core.Intelligence.Models
@using Playbook.Core.Recommendations
@using Playbook.Web.Features.Intelligence.Models
@using Playbook.Web.Features.League.Models
@inject ILeagueState LeagueState
@inject IRecommendationService RecommendationService
@inject IIntelligenceService IntelligenceService
@implements IDisposable

<PageTitle>Dashboard — Playbook</PageTitle>

<section class="pb-page">
    <header class="pb-page__header">
        <h1 class="pb-page__title">Dashboard</h1>
        <p class="pb-page__subtitle">
            @if (LeagueState.CurrentLeague is { } league)
            {
                <text>Personalized to @league.Name · @league.Season season</text>
            }
            else
            {
                <text>Select a league to personalize recommendations.</text>
            }
        </p>

        @if (LeagueState.CurrentLeague is { } current)
        {
            <div class="league-context">
                <div class="league-context__item">
                    <span class="league-context__label">Current League</span>
                    <span class="league-context__value">@current.Name</span>
                </div>
                <div class="league-context__item">
                    <span class="league-context__label">Platform</span>
                    <span class="league-context__value">@LeagueDisplay.Platform(current.Platform)</span>
                </div>
                <div class="league-context__item">
                    <span class="league-context__label">League Type</span>
                    <span class="league-context__value">@LeagueDisplay.LeagueType(current.LeagueType)</span>
                </div>
                <div class="league-context__item">
                    <span class="league-context__label">Scoring</span>
                    <span class="league-context__value">@LeagueDisplay.Scoring(current.ScoringType)</span>
                </div>
                <div class="league-context__item">
                    <span class="league-context__label">Week</span>
                    <span class="league-context__value">@current.CurrentWeek</span>
                </div>
            </div>
        }
    </header>

    <section class="dashboard-decisions" aria-labelledby="top-decisions-heading">
        <h2 id="top-decisions-heading" class="pb-card__title">Top Decisions</h2>
        <div class="decision-stack">
            @foreach (var recommendation in recommendations)
            {
                <DecisionCard Recommendation="recommendation" />
            }
        </div>
    </section>

    <div class="dashboard-grid">
        <article class="pb-card dashboard-intel">
            <h2 class="pb-card__title">Football Intelligence</h2>
            <div class="pb-card__body">
                @foreach (var fact in topFacts)
                {
                    <article class="intel-fact">
                        <div class="intel-fact__header">
                            <h3 class="intel-fact__title">@fact.Title</h3>
                            <div class="intel-fact__meta">
                                <span class="@IntelligencePresentation.ImportanceClass(fact.Importance)">
                                    @IntelligencePresentation.Importance(fact.Importance)
                                </span>
                                <span>@fact.Confidence%</span>
                                <span>@IntelligencePresentation.RelativeTime(fact.Created)</span>
                            </div>
                        </div>
                        <p class="intel-fact__description">@fact.Description</p>
                        <div class="intel-fact__meta">
                            <span>@IntelligencePresentation.Category(fact.Category)</span>
                            <span>@IntelligencePresentation.Source(fact.Source)</span>
                        </div>
                    </article>
                }
            </div>
        </article>

        <article class="pb-card">
            <h2 class="pb-card__title">Trending Players</h2>
            <div class="pb-card__body">
                @foreach (var item in Trending)
                {
                    <div class="pb-meta-row">
                        <span class="pb-meta-label">@item.Name</span>
                        <span class="pb-meta-value">@item.Trend</span>
                    </div>
                }
            </div>
        </article>

        <article class="pb-card">
            <h2 class="pb-card__title">System Status</h2>
            <div class="pb-card__body">
                @foreach (var item in SystemStatus)
                {
                    <div class="pb-meta-row">
                        <span class="pb-meta-label">@item.Component</span>
                        <span class="pb-badge">@item.Status</span>
                    </div>
                }
            </div>
        </article>
    </div>
</section>

@code {
    private IReadOnlyList<Recommendation> recommendations = [];
    private IReadOnlyList<IntelligenceFact> topFacts = [];

    protected override void OnInitialized()
    {
        LeagueState.Changed += OnLeagueChanged;
        recommendations = RecommendationService.GetTopRecommendations();
        topFacts = IntelligenceService.GetTopFacts(6);
    }

    private void OnLeagueChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => LeagueState.Changed -= OnLeagueChanged;

    private static readonly TrendingItem[] Trending =
    [
        new("Jordan Love", "↑ Usage"),
        new("Brian Thomas Jr.", "↑ Targets"),
        new("Bucky Irving", "↑ Snap share")
    ];

    private static readonly StatusItem[] SystemStatus =
    [
        new("Data Engine", "Stubbed"),
        new("Intelligence Engine", "Mock Ready"),
        new("News Engine", "Stubbed"),
        new("Decision Engine", "Offline"),
        new("League State", "Ready")
    ];

    private sealed record TrendingItem(string Name, string Trend);
    private sealed record StatusItem(string Component, string Status);
}
