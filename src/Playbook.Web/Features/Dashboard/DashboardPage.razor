@page "/"
@using Playbook.Application.Intelligence
@using Playbook.Application.Intelligence.Interfaces
@using Playbook.Application.Leagues
@using Playbook.Application.News
@using Playbook.Application.Players
@using Playbook.Application.Players.Data
@using Playbook.Application.Projections
@using Playbook.Application.Projections.Interfaces
@using Playbook.Application.Recommendations
@using Playbook.Application.Stats
@using Playbook.Application.Stats.Interfaces
@using Playbook.Core.Intelligence.Models
@using Playbook.Core.Recommendations
@using Playbook.Web.Features.Intelligence.Models
@using Playbook.Web.Features.League.Models
@inject ILeagueState LeagueState
@inject IRecommendationService RecommendationService
@inject IIntelligenceService IntelligenceService
@inject IIntelligenceSyncStatus IntelligenceSyncStatus
@inject IProjectionService ProjectionService
@inject IProjectionSyncStatus ProjectionSyncStatus
@inject IPlayerService PlayerService
@inject IPlayerDataSyncStatus PlayerDataSyncStatus
@inject IPlayerStatsService PlayerStatsService
@inject IPlayerStatsSyncStatus PlayerStatsSyncStatus
@inject ICollegeStatsSyncStatus CollegeStatsSyncStatus
@inject INewsProvider NewsProvider
@inject INewsSyncStatus NewsSyncStatus
@implements IDisposable

<PageTitle>Dashboard — Playbook</PageTitle>

<section class="pb-page">
    <header class="pb-page__header">
        <h1 class="pb-page__title">Dashboard</h1>
        <p class="pb-page__subtitle">
            @if (LeagueState.CurrentLeague is { } league)
            {
                <text>Personalized to @league.Name · @league.Season season</text>
            }
            else
            {
                <text>Select a league to personalize recommendations.</text>
            }
        </p>

        @if (LeagueState.CurrentLeague is { } current)
        {
            <div class="league-context">
                <div class="league-context__item">
                    <span class="league-context__label">Current League</span>
                    <span class="league-context__value">@current.Name</span>
                </div>
                <div class="league-context__item">
                    <span class="league-context__label">Platform</span>
                    <span class="league-context__value">@LeagueDisplay.Platform(current.Platform)</span>
                </div>
                <div class="league-context__item">
                    <span class="league-context__label">League Type</span>
                    <span class="league-context__value">@LeagueDisplay.LeagueType(current.LeagueType)</span>
                </div>
                <div class="league-context__item">
                    <span class="league-context__label">Scoring</span>
                    <span class="league-context__value">@LeagueDisplay.Scoring(current.ScoringType)</span>
                </div>
                <div class="league-context__item">
                    <span class="league-context__label">Week</span>
                    <span class="league-context__value">@current.CurrentWeek</span>
                </div>
            </div>
        }
    </header>

    <section class="dashboard-monitor" aria-labelledby="dev-monitor-heading">
        <div class="dashboard-monitor__header">
            <h2 id="dev-monitor-heading" class="pb-card__title" style="margin-bottom: 0;">Developer Monitor</h2>
            <div class="dashboard-heartbeat @(heartbeatTick ? "dashboard-heartbeat--tick" : null)"
                 aria-live="polite"
                 title="Updates every 30 seconds">
                <span class="dashboard-heartbeat__dot" aria-hidden="true">🟢</span>
                <span class="dashboard-heartbeat__label">Running</span>
                <span class="dashboard-heartbeat__tick">#@refreshCount · @lastUpdateDisplay</span>
            </div>
        </div>

        <article class="pb-card dev-status-card">
            <h2 class="pb-card__title">Development Status</h2>
            <div class="pb-card__body">
                <div class="pb-meta-row">
                    <span class="pb-meta-label">Build Status</span>
                    <span class="pb-meta-value pb-meta-value--live">@buildStatus</span>
                </div>
                <div class="pb-meta-row">
                    <span class="pb-meta-label">Background Service Status</span>
                    <span class="pb-meta-value">@backgroundServiceStatus</span>
                </div>
                <div class="pb-meta-row">
                    <span class="pb-meta-label">Last Update Time</span>
                    <span class="pb-meta-value">@lastUpdateDisplay</span>
                </div>
                <div class="pb-meta-row">
                    <span class="pb-meta-label">Mock Data Status</span>
                    <span class="pb-meta-value">@mockDataStatus</span>
                </div>
                <div class="pb-meta-row">
                    <span class="pb-meta-label">Current League</span>
                    <span class="pb-meta-value">@currentLeagueName</span>
                </div>
                <div class="pb-meta-row">
                    <span class="pb-meta-label">Application Version</span>
                    <span class="pb-meta-value">@AppInfo.Version</span>
                </div>
                <div class="pb-meta-row">
                    <span class="pb-meta-label">Current Time</span>
                    <span class="pb-meta-value">@currentTimeDisplay</span>
                </div>
                <div class="pb-meta-row">
                    <span class="pb-meta-label">Current Provider</span>
                    <span class="pb-meta-value pb-meta-value--live">@providerActive</span>
                </div>
                <div class="pb-meta-row">
                    <span class="pb-meta-label">Configured Provider</span>
                    <span class="pb-meta-value">@providerConfigured</span>
                </div>
                <div class="pb-meta-row">
                    <span class="pb-meta-label">Last Successful Sync</span>
                    <span class="pb-meta-value">@providerLastSync</span>
                </div>
                <div class="pb-meta-row">
                    <span class="pb-meta-label">Number of Players Loaded</span>
                    <span class="pb-meta-value">@providerPlayerCount</span>
                </div>
                <div class="pb-meta-row">
                    <span class="pb-meta-label">Provider Response Time</span>
                    <span class="pb-meta-value">@providerResponseTime</span>
                </div>
                <div class="pb-meta-row">
                    <span class="pb-meta-label">Last Error</span>
                    <span class="pb-meta-value">@providerLastError</span>
                </div>
                <div class="pb-meta-row">
                    <span class="pb-meta-label">Current News Provider</span>
                    <span class="pb-meta-value pb-meta-value--live">@newsProviderActive</span>
                </div>
                <div class="pb-meta-row">
                    <span class="pb-meta-label">Articles Loaded</span>
                    <span class="pb-meta-value">@newsArticleCount</span>
                </div>
                <div class="pb-meta-row">
                    <span class="pb-meta-label">Last News Sync</span>
                    <span class="pb-meta-value">@newsLastSync</span>
                </div>
                <div class="pb-meta-row">
                    <span class="pb-meta-label">News Provider Response Time</span>
                    <span class="pb-meta-value">@newsResponseTime</span>
                </div>
                <div class="pb-meta-row">
                    <span class="pb-meta-label">Articles Processed</span>
                    <span class="pb-meta-value">@intelArticlesProcessed</span>
                </div>
                <div class="pb-meta-row">
                    <span class="pb-meta-label">Intelligence Facts Generated</span>
                    <span class="pb-meta-value">@intelFactsGenerated</span>
                </div>
                <div class="pb-meta-row">
                    <span class="pb-meta-label">Analyzer Runtime</span>
                    <span class="pb-meta-value">@intelRuntime</span>
                </div>
                <div class="pb-meta-row">
                    <span class="pb-meta-label">Last Analysis Time</span>
                    <span class="pb-meta-value">@intelLastAnalysis</span>
                </div>
                <div class="pb-meta-row">
                    <span class="pb-meta-label">Profiles Generated</span>
                    <span class="pb-meta-value">@intelProfilesGenerated</span>
                </div>
                <div class="pb-meta-row">
                    <span class="pb-meta-label">Facts Aggregated</span>
                    <span class="pb-meta-value">@intelFactsAggregated</span>
                </div>
                <div class="pb-meta-row">
                    <span class="pb-meta-label">Average Facts Per Player</span>
                    <span class="pb-meta-value">@intelAvgFacts</span>
                </div>
                <div class="pb-meta-row">
                    <span class="pb-meta-label">Aggregation Runtime</span>
                    <span class="pb-meta-value">@intelAggRuntime</span>
                </div>
                <div class="pb-meta-row">
                    <span class="pb-meta-label">Players Projected</span>
                    <span class="pb-meta-value">@projectionPlayers</span>
                </div>
                <div class="pb-meta-row">
                    <span class="pb-meta-label">Unique Projection Values</span>
                    <span class="pb-meta-value">@projectionUnique</span>
                </div>
                <div class="pb-meta-row">
                    <span class="pb-meta-label">Average Projection</span>
                    <span class="pb-meta-value">@projectionAverage</span>
                </div>
                <div class="pb-meta-row">
                    <span class="pb-meta-label">Average Confidence</span>
                    <span class="pb-meta-value">@projectionAvgConfidence</span>
                </div>
                <div class="pb-meta-row">
                    <span class="pb-meta-label">Projection Runtime</span>
                    <span class="pb-meta-value">@projectionRuntime</span>
                </div>
                <div class="pb-meta-row">
                    <span class="pb-meta-label">Stats Provider</span>
                    <span class="pb-meta-value pb-meta-value--live">@statsProvider</span>
                </div>
                <div class="pb-meta-row">
                    <span class="pb-meta-label">Players With Stats</span>
                    <span class="pb-meta-value">@statsPlayers</span>
                </div>
                <div class="pb-meta-row">
                    <span class="pb-meta-label">Seasons Loaded</span>
                    <span class="pb-meta-value">@statsSeasons</span>
                </div>
                <div class="pb-meta-row">
                    <span class="pb-meta-label">Current Season Records</span>
                    <span class="pb-meta-value">@statsCurrent</span>
                </div>
                <div class="pb-meta-row">
                    <span class="pb-meta-label">Historical Records</span>
                    <span class="pb-meta-value">@statsHistorical</span>
                </div>
                <div class="pb-meta-row">
                    <span class="pb-meta-label">Last Stats Sync</span>
                    <span class="pb-meta-value">@statsLastSync</span>
                </div>
                <div class="pb-meta-row">
                    <span class="pb-meta-label">Stats Sync Runtime</span>
                    <span class="pb-meta-value">@statsRuntime</span>
                </div>
                <div class="pb-meta-row">
                    <span class="pb-meta-label">Last Stats Error</span>
                    <span class="pb-meta-value">@statsLastError</span>
                </div>
                <div class="pb-meta-row">
                    <span class="pb-meta-label">College Provider</span>
                    <span class="pb-meta-value pb-meta-value--live">@collegeProvider</span>
                </div>
                <div class="pb-meta-row">
                    <span class="pb-meta-label">College Players Loaded</span>
                    <span class="pb-meta-value">@collegePlayers</span>
                </div>
                <div class="pb-meta-row">
                    <span class="pb-meta-label">College Seasons Loaded</span>
                    <span class="pb-meta-value">@collegeSeasons</span>
                </div>
                <div class="pb-meta-row">
                    <span class="pb-meta-label">Last College Sync</span>
                    <span class="pb-meta-value">@collegeLastSync</span>
                </div>
                <div class="pb-meta-row">
                    <span class="pb-meta-label">College Sync Error</span>
                    <span class="pb-meta-value">@collegeLastError</span>
                </div>
            </div>
        </article>

        <article class="pb-card engine-status">
            <h2 class="pb-card__title">Engine Status</h2>
            <div class="engine-status__grid">
                @foreach (var engine in engines)
                {
                    <div class="engine-status__item">
                        <span class="engine-status__name">@engine.Name</span>
                        <span class="@EngineStateClass(engine.State)">@engine.State</span>
                    </div>
                }
            </div>
        </article>
    </section>

    <section class="dashboard-news" aria-labelledby="top-intelligence-heading">
        <h2 id="top-intelligence-heading" class="pb-card__title">Top Player Intelligence Changes</h2>
        <div class="news-stack">
            @foreach (var profile in topProfiles)
            {
                <article class="news-item">
                    <div class="news-item__header">
                        <h3 class="news-item__title">
                            @IntelligencePresentation.ChangeArrow(profile.ChangeSignal)
                            @ResolvePlayerName(profile.PlayerId)
                        </h3>
                        <span class="pb-badge pb-badge--accent">@profile.OverallConfidence%</span>
                    </div>
                    <p class="news-item__summary">@profile.Headline</p>
                    <div class="news-item__meta">
                        <span>Health @profile.HealthScore</span>
                        <span>Opportunity @profile.OpportunityScore</span>
                        <span>Usage @profile.UsageScore</span>
                        <span>@IntelligencePresentation.TrendLabel(profile.TrendDirection)</span>
                        <span>@IntelligencePresentation.RelativeTime(profile.LastUpdated)</span>
                    </div>
                </article>
            }

            @if (topProfiles.Count == 0)
            {
                <p class="player-section__muted">No player intelligence profiles generated yet.</p>
            }
        </div>
    </section>

    <section class="dashboard-decisions" aria-labelledby="top-decisions-heading">
        <h2 id="top-decisions-heading" class="pb-card__title">Top Decisions</h2>
        <div class="decision-stack">
            @foreach (var recommendation in recommendations)
            {
                <DecisionCard Recommendation="recommendation" />
            }
        </div>
    </section>

    <div class="dashboard-grid dashboard-grid--stack">
        <article class="pb-card">
            <h2 class="pb-card__title">Trending Players</h2>
            <div class="pb-card__body">
                @foreach (var item in Trending)
                {
                    <div class="pb-meta-row">
                        <span class="pb-meta-label">@item.Name</span>
                        <span class="pb-meta-value">@item.Trend</span>
                    </div>
                }
            </div>
        </article>
    </div>
</section>

@code {
    private IReadOnlyList<Recommendation> recommendations = [];
    private IReadOnlyList<PlayerIntelligenceProfile> topProfiles = [];

    private string buildStatus = "Succeeded";
    private string backgroundServiceStatus = "Running";
    private string mockDataStatus = "Active";
    private string currentLeagueName = "—";
    private string lastUpdateDisplay = "—";
    private string currentTimeDisplay = "—";
    private int refreshCount;
    private bool heartbeatTick;

    private PeriodicTimer? refreshTimer;
    private CancellationTokenSource? cts;

    private static readonly EngineStatusItem[] engines =
    [
        new("Player Engine", "Ready"),
        new("League Engine", "Ready"),
        new("Intelligence Engine", "Ready"),
        new("Projection Engine", "Ready"),
        new("Recommendation Engine", "In Development"),
        new("Data Engine", "In Development")
    ];

    private string providerConfigured = "—";
    private string providerActive = "—";
    private string providerLastSync = "—";
    private string providerPlayerCount = "—";
    private string providerResponseTime = "—";
    private string providerLastError = "None";
    private string newsProviderActive = "—";
    private string newsArticleCount = "—";
    private string newsLastSync = "—";
    private string newsResponseTime = "—";
    private string intelArticlesProcessed = "—";
    private string intelFactsGenerated = "—";
    private string intelRuntime = "—";
    private string intelLastAnalysis = "—";
    private string intelProfilesGenerated = "—";
    private string intelFactsAggregated = "—";
    private string intelAvgFacts = "—";
    private string intelAggRuntime = "—";
    private string projectionPlayers = "—";
    private string projectionUnique = "—";
    private string projectionAverage = "—";
    private string projectionRuntime = "—";
    private string projectionAvgConfidence = "—";
    private string statsProvider = "—";
    private string statsPlayers = "—";
    private string statsSeasons = "—";
    private string statsCurrent = "—";
    private string statsHistorical = "—";
    private string statsLastSync = "—";
    private string statsRuntime = "—";
    private string statsLastError = "None";
    private string collegeProvider = "—";
    private string collegePlayers = "—";
    private string collegeSeasons = "—";
    private string collegeLastSync = "—";
    private string collegeLastError = "None";

    protected override void OnInitialized()
    {
        LeagueState.Changed += OnLeagueChanged;
        RefreshDashboard();
        cts = new CancellationTokenSource();
        _ = RunAutoRefreshAsync(cts.Token);
    }

    private async Task RunAutoRefreshAsync(CancellationToken cancellationToken)
    {
        refreshTimer = new PeriodicTimer(TimeSpan.FromSeconds(30));

        try
        {
            while (await refreshTimer.WaitForNextTickAsync(cancellationToken))
            {
                RefreshDashboard();
                await InvokeAsync(StateHasChanged);

                heartbeatTick = true;
                await InvokeAsync(StateHasChanged);
                await Task.Delay(450, cancellationToken);
                heartbeatTick = false;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // Dashboard disposed.
        }
    }

    private void RefreshDashboard()
    {
        var now = DateTime.Now;
        refreshCount++;
        lastUpdateDisplay = now.ToString("h:mm:ss tt");
        currentTimeDisplay = now.ToString("h:mm:ss tt");
        currentLeagueName = LeagueState.CurrentLeague?.Name ?? "None selected";
        buildStatus = "Succeeded";
        backgroundServiceStatus = "Running";

        _ = PlayerService.GetAllPlayers();
        providerConfigured = PlayerDataSyncStatus.ConfiguredProvider;
        providerActive = PlayerDataSyncStatus.UsedFallback
            ? $"{PlayerDataSyncStatus.ActiveProvider} (fallback)"
            : PlayerDataSyncStatus.ActiveProvider;
        providerLastSync = PlayerDataSyncStatus.LastSuccessfulSync?.ToLocalTime().ToString("h:mm:ss tt") ?? "—";
        providerPlayerCount = PlayerDataSyncStatus.PlayersLoaded.ToString();
        providerResponseTime = PlayerDataSyncStatus.ProviderResponseTime is { } elapsed
            ? $"{elapsed.TotalMilliseconds:0} ms"
            : "—";
        providerLastError = string.IsNullOrWhiteSpace(PlayerDataSyncStatus.LastError)
            ? "None"
            : PlayerDataSyncStatus.LastError;
        mockDataStatus = PlayerDataSyncStatus.ActiveProvider.Equals("Mock", StringComparison.OrdinalIgnoreCase)
            ? (PlayerDataSyncStatus.UsedFallback ? "Fallback Active" : "Active")
            : "Standby";

        _ = NewsProvider.GetLatest(1);
        newsProviderActive = NewsSyncStatus.UsedFallback
            ? $"{NewsSyncStatus.ActiveProvider} (fallback)"
            : NewsSyncStatus.ActiveProvider;
        newsArticleCount = NewsSyncStatus.ArticlesLoaded.ToString();
        newsLastSync = NewsSyncStatus.LastSuccessfulSync?.ToLocalTime().ToString("h:mm:ss tt") ?? "—";
        newsResponseTime = NewsSyncStatus.ProviderResponseTime is { } newsElapsed
            ? $"{newsElapsed.TotalMilliseconds:0} ms"
            : "—";

        topProfiles = IntelligenceService.GetTopProfiles(8);
        intelArticlesProcessed = IntelligenceSyncStatus.ArticlesProcessed.ToString();
        intelFactsGenerated = IntelligenceSyncStatus.FactsGenerated.ToString();
        intelRuntime = IntelligenceSyncStatus.AnalyzerRuntime is { } runtime
            ? $"{runtime.TotalMilliseconds:0} ms"
            : "—";
        intelLastAnalysis = IntelligenceSyncStatus.LastAnalysisTime?.ToLocalTime().ToString("h:mm:ss tt") ?? "—";
        intelProfilesGenerated = IntelligenceSyncStatus.ProfilesGenerated.ToString();
        intelFactsAggregated = IntelligenceSyncStatus.FactsAggregated.ToString();
        intelAvgFacts = IntelligenceSyncStatus.AverageFactsPerPlayer.ToString("0.00");
        intelAggRuntime = IntelligenceSyncStatus.AggregationRuntime is { } aggRuntime
            ? $"{aggRuntime.TotalMilliseconds:0} ms"
            : "—";

        _ = ProjectionService.GetAllProjections();
        projectionPlayers = ProjectionSyncStatus.PlayersProjected.ToString();
        projectionUnique = ProjectionSyncStatus.UniqueProjectionValues.ToString();
        projectionAverage = ProjectionSyncStatus.PlayersProjected > 0
            ? ProjectionSyncStatus.AverageProjection.ToString("0.0")
            : "—";
        projectionRuntime = ProjectionSyncStatus.ProjectionRuntime is { } projRuntime
            ? $"{projRuntime.TotalMilliseconds:0} ms"
            : "—";
        projectionAvgConfidence = ProjectionSyncStatus.PlayersProjected > 0
            ? ProjectionSyncStatus.AverageProjectionConfidence.ToString("0.0")
            : "—";

        _ = PlayerStatsService.GetAllStats();
        statsProvider = PlayerStatsSyncStatus.UsedFallback
            ? $"{PlayerStatsSyncStatus.ActiveProvider} (fallback)"
            : PlayerStatsSyncStatus.UsedCache
                ? $"{PlayerStatsSyncStatus.ActiveProvider} (cache)"
                : PlayerStatsSyncStatus.ActiveProvider;
        statsPlayers = PlayerStatsSyncStatus.PlayersWithStats.ToString();
        statsSeasons = PlayerStatsSyncStatus.SeasonsLoaded.ToString();
        statsCurrent = PlayerStatsSyncStatus.CurrentSeasonRecords.ToString();
        statsHistorical = PlayerStatsSyncStatus.HistoricalRecords.ToString();
        statsLastSync = PlayerStatsSyncStatus.LastStatsSync?.ToLocalTime().ToString("h:mm:ss tt") ?? "—";
        statsRuntime = PlayerStatsSyncStatus.StatsSyncRuntime is { } statsElapsed
            ? $"{statsElapsed.TotalMilliseconds:0} ms"
            : "—";
        statsLastError = string.IsNullOrWhiteSpace(PlayerStatsSyncStatus.LastStatsError)
            ? "None"
            : PlayerStatsSyncStatus.LastStatsError;

        collegeProvider = CollegeStatsSyncStatus.UsedFallback
            ? $"{CollegeStatsSyncStatus.ActiveProvider} (fallback)"
            : CollegeStatsSyncStatus.UsedCache
                ? $"{CollegeStatsSyncStatus.ActiveProvider} (cache)"
                : CollegeStatsSyncStatus.ActiveProvider;
        collegePlayers = CollegeStatsSyncStatus.CollegePlayersLoaded.ToString();
        collegeSeasons = CollegeStatsSyncStatus.CollegeSeasonsLoaded.ToString();
        collegeLastSync = CollegeStatsSyncStatus.LastCollegeSync?.ToLocalTime().ToString("h:mm:ss tt") ?? "—";
        collegeLastError = string.IsNullOrWhiteSpace(CollegeStatsSyncStatus.CollegeSyncError)
            ? "None"
            : CollegeStatsSyncStatus.CollegeSyncError;

        recommendations = RecommendationService.GetTopRecommendations();
    }

    private string ResolvePlayerName(Guid playerId) =>
        PlayerService.GetPlayer(playerId)?.FullName ?? "Linked player";

    private void OnLeagueChanged()
    {
        currentLeagueName = LeagueState.CurrentLeague?.Name ?? "None selected";
        _ = InvokeAsync(StateHasChanged);
    }

    private static string EngineStateClass(string state) => state switch
    {
        "Ready" => "engine-status__state engine-status__state--ready",
        "In Development" => "engine-status__state engine-status__state--development",
        _ => "engine-status__state engine-status__state--offline"
    };

    public void Dispose()
    {
        LeagueState.Changed -= OnLeagueChanged;
        cts?.Cancel();
        cts?.Dispose();
        refreshTimer?.Dispose();
    }

    private static readonly TrendingItem[] Trending =
    [
        new("Jordan Love", "↑ Usage"),
        new("Brian Thomas Jr.", "↑ Targets"),
        new("Bucky Irving", "↑ Snap share")
    ];

    private sealed record TrendingItem(string Name, string Trend);
    private sealed record EngineStatusItem(string Name, string State);
}
