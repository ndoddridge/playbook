@page "/my-teams"
@using Playbook.Application.Leagues
@using Playbook.Application.Players
@using Playbook.Core.Leagues
@using Playbook.Core.Players
@using Playbook.Web.Features.League.Models
@inject ILeagueState LeagueState
@inject IPlayerService PlayerService
@implements IDisposable

<PageTitle>My Teams — Playbook</PageTitle>

<section class="pb-page">
    <header class="pb-page__header">
        <h1 class="pb-page__title">My Teams</h1>
        <p class="pb-page__subtitle">
            @if (current is { } league)
            {
                <text>
                    Rosters for @league.Name
                    <span class="league-source-badge @(LeagueDisplay.IsLive(league) ? "league-source-badge--live" : "league-source-badge--mock")">
                        @LeagueDisplay.DataSource(league.DataSource)
                    </span>
                </text>
            }
            else
            {
                <text>Select or connect a league to view fantasy rosters.</text>
            }
        </p>
    </header>

    @if (current is null)
    {
        <article class="pb-card">
            <div class="pb-card__body">
                <p class="pb-empty">No league selected. Use the league switcher to pick a mock league or connect a Sleeper league by ID.</p>
            </div>
        </article>
    }
    else if (teams.Count == 0)
    {
        <article class="pb-card">
            <div class="pb-card__body">
                <p class="pb-empty">No teams loaded for this league yet.</p>
            </div>
        </article>
    }
    else
    {
        <div class="my-teams-meta">
            <span>@LeagueDisplay.Platform(current.Platform)</span>
            <span>·</span>
            <span>@LeagueDisplay.LeagueType(current.LeagueType)</span>
            <span>·</span>
            <span>@LeagueDisplay.ScoringDetailed(current)</span>
            <span>·</span>
            <span>@current.NumberOfTeams teams</span>
            <span>·</span>
            <span>@current.Season · Week @current.CurrentWeek</span>
            @if (!string.IsNullOrWhiteSpace(current.ExternalId))
            {
                <span>·</span>
                <span>ID @current.ExternalId</span>
            }
        </div>

        @if (!LeagueDisplay.IsLive(current))
        {
            <p class="my-teams-note">
                This is mock demo league context. Connect a Sleeper league ID from the league switcher to load real rosters and scoring.
            </p>
        }

        <div class="my-teams-grid">
            @foreach (var team in teams)
            {
                <article class="pb-card my-team-card">
                    <h2 class="pb-card__title">@(team.TeamName ?? team.DisplayName)</h2>
                    <div class="pb-card__body">
                        <p class="my-team-card__owner">@team.DisplayName · Roster #@team.RosterId</p>
                        @if (team.PlayerIds.Count == 0)
                        {
                            <p class="pb-empty">No players on this roster@(LeagueDisplay.IsLive(current) ? "." : " (demo leagues do not seed player ownership).")</p>
                        }
                        else
                        {
                            <ul class="my-team-card__players">
                                @foreach (var playerId in team.PlayerIds.Take(18))
                                {
                                    var player = PlayerService.GetPlayer(playerId);
                                    var isStarter = team.StarterIds.Contains(playerId);
                                    <li>
                                        @(player?.FullName ?? "Unknown player")
                                        @if (player is not null)
                                        {
                                            <span class="my-team-card__pos">@PlayerPresentation.PositionLabel(player.Position)</span>
                                        }
                                        @if (isStarter)
                                        {
                                            <span class="my-team-card__starter">Starter</span>
                                        }
                                    </li>
                                }
                            </ul>
                            @if (team.PlayerIds.Count > 18)
                            {
                                <p class="player-section__muted">+@(team.PlayerIds.Count - 18) more players</p>
                            }
                        }
                    </div>
                </article>
            }
        </div>
    }
</section>

@code {
    private League? current;
    private IReadOnlyList<FantasyTeam> teams = [];

    protected override void OnInitialized()
    {
        LeagueState.Changed += OnLeagueChanged;
        Refresh();
    }

    private void Refresh()
    {
        current = LeagueState.CurrentLeague;
        teams = LeagueState.GetCurrentTeams();
    }

    private void OnLeagueChanged() => InvokeAsync(() =>
    {
        Refresh();
        StateHasChanged();
    });

    public void Dispose() => LeagueState.Changed -= OnLeagueChanged;
}
