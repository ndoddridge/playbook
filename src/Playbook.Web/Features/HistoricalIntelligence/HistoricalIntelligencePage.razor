@page "/historical-intelligence"
@using Playbook.Application.Historical
@inject IHistoricalLeagueIntelligenceService Historical

<PageTitle>Historical League Intelligence — Playbook</PageTitle>
<section class="pb-page hi-page">
    <header class="pb-page__header"><h1 class="pb-page__title">Historical League Intelligence</h1><p class="pb-page__subtitle">Evidence from completed drafts. Historical behavior is context, not a live-draft recommendation.</p></header>
    <section class="hi-card"><h2>Import historical season</h2><div class="hi-row"><input @bind="sleeperLeagueId" placeholder="Sleeper league ID" /><button @onclick="ImportSleeperAsync">Import linked Sleeper history</button></div><details><summary>Structured import</summary><textarea @bind="importJson" placeholder="HistoricalLeagueDraft JSON"></textarea><button @onclick="ImportJsonAsync">Validate and import JSON</button></details>@if (!string.IsNullOrWhiteSpace(message)) { <p class="@(failed ? "hi-error" : "hi-success")">@message</p> }</section>
    <section class="hi-card"><h2>Historical drafts</h2>@if (drafts.Count == 0) { <p>No historical drafts imported yet.</p> } else { <div class="hi-grid">@foreach (var draft in drafts) { <article><strong>@draft.LeagueName · @draft.Season</strong><br />@draft.TeamCount teams · @draft.RoundCount rounds · @draft.Picks.Count picks<br /><small>@draft.LeagueType · @draft.Source · @(draft.IsComplete ? "Import complete" : "Incomplete — retained with warning")</small></article> }</div> }</section>
    @if (drafts.Count > 0) { var primary = drafts.First(); <section class="hi-card"><h2>League patterns</h2><p>Position draft ranges (redraft only; descriptive, not predictive).</p><div class="hi-grid">@foreach (var range in Historical.GetPositionDraftRanges(primary.LeagueId)) { <article><strong>@range.Position</strong><br />Picks @range.EarliestPick–@range.LatestPick · @range.SelectionCount selections<br /><small>Evidence: @range.EvidenceStrength</small></article> }</div></section><section class="hi-card"><h2>Owner patterns</h2><p>Samples are displayed with evidence strength; one or two selections are insufficient.</p><div class="hi-grid">@foreach (var tendency in Historical.GetOwnerTendencies(primary.LeagueId).Take(12)) { <article><strong>@tendency.OwnerName</strong><br />@tendency.Position · round @tendency.Round · @tendency.SelectionCount picks<br /><small>@tendency.SeasonCount season(s) · @tendency.EvidenceStrength</small></article> }</div></section> }
</section>
@code { private string sleeperLeagueId = string.Empty, importJson = string.Empty, message = string.Empty; private bool failed; private IReadOnlyList<Playbook.Core.Historical.HistoricalLeagueDraft> drafts = []; protected override void OnInitialized() => Refresh(); private async Task ImportSleeperAsync() { Show(await Historical.ImportSleeperLeagueHistoryAsync(sleeperLeagueId)); } private async Task ImportJsonAsync() { Show(await Historical.ImportJsonAsync(importJson)); } private void Show(Playbook.Core.Historical.HistoricalImportResult result) { failed = !result.Succeeded; message = result.Succeeded ? $"Import complete. {string.Join(" ", result.Warnings)}" : string.Join(" ", result.Errors); Refresh(); } private void Refresh() => drafts = Historical.GetDrafts(); }
