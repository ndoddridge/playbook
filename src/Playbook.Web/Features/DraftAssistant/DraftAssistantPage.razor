@page "/draft-assistant"
@using Playbook.Application.Draft
@using Playbook.Application.Leagues
@using Playbook.Core.Draft
@using Playbook.Web.Features.DraftAssistant.Components
@inject ILeagueState LeagueState
@inject IDraftAssistantService DraftAssistant
@implements IDisposable

<PageTitle>Draft Assistant — Playbook</PageTitle>

<section class="pb-page ti-page da-page">
    <header class="pb-page__header ti-page__header">
        <h1 class="pb-page__title">Draft Assistant</h1>
        <p class="pb-page__subtitle">Live recommendations for your next Sleeper pick.</p>
    </header>

    <section class="da-attach">
        <label class="da-attach__label" for="da-attach-input">
            Following a mock draft? Paste its Sleeper draft link
        </label>
        <div class="da-attach__row">
            <input id="da-attach-input"
                   class="da-attach__input"
                   type="text"
                   inputmode="url"
                   autocomplete="off"
                   placeholder="https://sleeper.com/draft/nfl/..."
                   @bind="attachInput"
                   @bind:event="oninput" />
            <button type="button" class="da-attach__btn" @onclick="AttachAsync">Follow</button>
        </div>
        @if (!string.IsNullOrWhiteSpace(attachError))
        {
            <p class="da-attach__error">@attachError</p>
        }
        else if (DraftAssistant.AttachedDraftId is string followedId)
        {
            <p class="da-attach__status">
                Following draft @followedId
                <button type="button" class="da-attach__clear" @onclick="DetachAsync">stop following</button>
            </p>
        }
    </section>

    <DraftImportPanel OnImported="() => LoadAsync(cts?.Token ?? CancellationToken.None)" />

    @if (isLoading && report is null)
    {
        <p class="pb-empty">Loading draft state…</p>
    }
    else if (report is null || report.Board is null)
    {
        <p class="pb-empty">@(report?.StatusMessage ?? "Draft Assistant is unavailable.")</p>
    }
    else
    {
        var board = report.Board;
        var recentPicks = board.Picks.Where(p => p.IsMade).OrderByDescending(p => p.PickNumber).Take(10).ToList();

        <section class="da-status @(report.IsStale ? "da-status--stale" : report.IsOnTheClock ? "da-status--onclock" : "")">
            <div class="da-status__row">
                <span class="pb-badge @(report.IsStale ? "pb-badge--danger" : report.IsOnTheClock ? "pb-badge--accent" : "pb-badge--info")">
                    @(report.IsStale ? "Offline" : board.Status.ToString())
                </span>
                <span class="da-status__message">@report.StatusMessage</span>
            </div>
            <p class="ti-footnote">
                Pick @board.NextPickNumber of @(board.TotalRounds * board.TeamCount)
                · Round @DraftOrderCalculator.RoundForPick(board.NextPickNumber, board.TeamCount)
                · Updated @report.GeneratedAt.ToLocalTime().ToString("h:mm:ss tt")
            </p>
        </section>

        @if (report.IsDynasty && report.LeagueId is Guid strategyLeagueId)
        {
            <section class="da-strategy" aria-labelledby="da-strategy-title">
                <h2 id="da-strategy-title" class="da-strategy__title">Dynasty strategy</h2>
                <div class="da-strategy__options" role="group" aria-label="Dynasty strategy">
                    @foreach (var option in AllStrategies)
                    {
                        <button type="button"
                                class="da-strategy__option @(report.Strategy == option ? "da-strategy__option--active" : "")"
                                aria-pressed="@(report.Strategy == option)"
                                @onclick="() => SelectStrategy(strategyLeagueId, option)">
                            @DynastyStrategyPolicy.DisplayName(option)
                        </button>
                    }
                </div>
                <p class="da-strategy__hint">@DynastyStrategyPolicy.Description(report.Strategy)</p>
            </section>
        }

        @if (report.RosterNeeds.Count > 0)
        {
            <section class="ti-section" aria-labelledby="da-needs-title">
                <h2 id="da-needs-title" class="ti-section__title">Your roster construction</h2>
                <div class="da-needs">
                    @foreach (var need in report.RosterNeeds)
                    {
                        <span class="pb-badge @NeedBadgeCss(need.NeedLevel)">
                            @need.PositionLabel @need.CurrentCount/@need.TargetStarters
                        </span>
                    }
                </div>
            </section>
        }

        @if (report.Recommended is not null)
        {
            <p class="da-clock-state @(report.IsOnTheClock ? "da-clock-state--onclock" : "da-clock-state--preparing")">
                @(report.IsOnTheClock ? "ON THE CLOCK" : "PREPARING FOR YOUR PICK")
            </p>
            @if (!string.IsNullOrWhiteSpace(report.DecisionSummary))
            {
                <p class="da-decision">
                    <span class="da-decision__phase">@DraftPhasePolicy.DisplayName(report.Phase)</span>
                    @report.DecisionSummary
                </p>
            }
            <section class="ti-section" aria-labelledby="da-rec-title">
                <h2 id="da-rec-title" class="ti-section__title">
                    @(report.IsOnTheClock ? "Recommended pick" : "Current best pick if you were on the clock")
                </h2>
                <DraftRecommendationCard Recommendation="report.Recommended" IsPrimary="true" IsTarget="IsTarget(report.Recommended.PlayerId)" OnToggleTarget="ToggleTarget" />
            </section>

            @if (report.Alternatives.Count > 0)
            {
                <section class="ti-section" aria-labelledby="da-alt-title">
                    <h2 id="da-alt-title" class="ti-section__title">Alternatives</h2>
                    <div class="da-alt-grid">
                        @foreach (var alt in report.Alternatives)
                        {
                            <DraftRecommendationCard Recommendation="alt" IsPrimary="false" IsTarget="IsTarget(alt.PlayerId)" OnToggleTarget="ToggleTarget" />
                        }
                    </div>
                </section>
            }

            @if (report.TargetWatch.Count > 0)
            {
                <section class="ti-section ti-section--secondary"><h2 class="ti-section__title">Target watch</h2><div class="da-needs">@foreach (var target in report.TargetWatch) { <article><strong>@target.PlayerName</strong> · @target.Assessment.Recommendation<br /><small>Range: @(target.Assessment.Availability.LeagueRange is { } r ? $"{r.MinimumPick}-{r.MaximumPick}, median {r.MedianPick:0.#}" : "unknown") · Current @target.CurrentPick · Next @target.NextPick</small><br /><small>@target.Assessment.Explanation</small></article> }</div></section>
            }

            @if (report.RouteTree is { } tree)
            {
                <section class="ti-section ti-section--secondary" aria-labelledby="da-route-title">
                    <h2 id="da-route-title" class="ti-section__title">What's next</h2>
                    @if (tree.LikelyNextTarget is not null)
                    {
                        <p class="ti-footnote">Likely next target: <strong>@tree.LikelyNextTarget.PlayerName</strong> (@tree.LikelyNextTarget.PositionLabel)</p>
                    }
                    @if (tree.IfTakenBranches.Count > 0)
                    {
                        <div class="da-alt-grid">
                            @foreach (var branch in tree.IfTakenBranches)
                            {
                                <article>
                                    <p class="ti-footnote">If <strong>@branch.TriggerPlayerName</strong> is taken first:</p>
                                    <DraftRecommendationCard Recommendation="branch.ThenRecommend" IsPrimary="false" />
                                </article>
                            }
                        </div>
                    }
                </section>
            }

            @if (report.MyTendencies is { } mine)
            {
                <section class="ti-section ti-section--secondary" aria-labelledby="da-mine-title">
                    <h2 id="da-mine-title" class="ti-section__title">Your tendencies this mock (session only)</h2>
                    <p class="ti-footnote">@mine.RosterBuildPattern · @mine.PickCount pick@(mine.PickCount == 1 ? "" : "s") · evidence: @mine.EvidenceStrength</p>
                    @if (mine.PositionEmphasis.Count > 0)
                    {
                        <div class="da-needs">
                            @foreach (var pos in mine.PositionEmphasis)
                            {
                                <span class="pb-badge">@pos.Position: @pos.PickCount (avg round @pos.AverageRound.ToString("0.#"))</span>
                            }
                        </div>
                    }
                    @if (mine.DecisionsVsRecommendations.Count > 0)
                    {
                        <ul class="ti-list ti-list--compact">
                            @foreach (var decision in mine.DecisionsVsRecommendations)
                            {
                                <li>Pick @decision.PickNumber: @decision.PickedPlayerName — @decision.Alignment@(decision.MatchedCategory is { } cat ? $" ({RecommendationCategoryPolicy.DisplayName(cat)})" : "")</li>
                            }
                        </ul>
                    }
                </section>
            }
        }
        else if (board.Status == DraftStatus.Drafting)
        {
            <p class="pb-empty">No recommendation available — every remaining player is missing a projection.</p>
        }

        @if (report.UnavailableSignals.Count > 0)
        {
            <section class="ti-section ti-section--secondary">
                <h2 class="ti-section__title">Not yet factored in</h2>
                <ul class="ti-list">
                    @foreach (var missing in report.UnavailableSignals)
                    {
                        <li>@missing</li>
                    }
                </ul>
            </section>
        }

        @if (recentPicks.Count > 0)
        {
            <section class="ti-section ti-section--secondary" aria-labelledby="da-board-title">
                <h2 id="da-board-title" class="ti-section__title">Recent picks</h2>
                <ul class="ti-list ti-list--compact">
                    @foreach (var pick in recentPicks)
                    {
                        <li>
                            Pick @pick.PickNumber (Rd @pick.Round): @(pick.PlayerName ?? "—")
                            @(pick.PositionLabel is null ? "" : $"({pick.PositionLabel})")
                        </li>
                    }
                </ul>
            </section>
        }
    }
</section>

@code {
    private string attachInput = "";
    private string? attachError;
    private bool IsTarget(Guid playerId) => report?.LeagueId is Guid leagueId && DraftAssistant.GetTargets(leagueId).Contains(playerId);
    private async Task ToggleTarget(Guid playerId) { if (report?.LeagueId is Guid leagueId) { DraftAssistant.ToggleTarget(leagueId, playerId); await LoadAsync(cts?.Token ?? CancellationToken.None); } }

    /// <summary>
    /// Follow a specific Sleeper draft by pasted link. This is what makes mock drafts work: a
    /// Sleeper mock lives in its own league that the user has not connected, so resolving a draft
    /// from the connected league can never find it.
    /// </summary>
    private async Task AttachAsync()
    {
        attachError = null;

        if (!DraftAssistant.AttachDraft(attachInput))
        {
            attachError = "That doesn't look like a Sleeper draft link. Open the draft in Sleeper, "
                        + "copy its link, and paste it here.";
            return;
        }

        attachInput = "";
        await LoadAsync(cts?.Token ?? CancellationToken.None);
    }

    private async Task DetachAsync()
    {
        DraftAssistant.DetachDraft();
        attachError = null;
        await LoadAsync(cts?.Token ?? CancellationToken.None);
    }

    private static readonly DynastyStrategy[] AllStrategies =
    [
        DynastyStrategy.ChampionshipCompetitor,
        DynastyStrategy.Hybrid,
        DynastyStrategy.Rebuild
    ];

    /// <summary>
    /// Applies immediately: the strategy is stored against the league and the board is rebuilt,
    /// so the change is visible in the recommendation rather than only in the UI.
    /// </summary>
    private async Task SelectStrategy(Guid leagueId, DynastyStrategy strategy)
    {
        DraftAssistant.SetStrategy(leagueId, strategy);
        await LoadAsync(cts?.Token ?? CancellationToken.None);
    }

    private DraftAssistantReport? report;
    private bool isLoading = true;
    private PeriodicTimer? pollTimer;
    private CancellationTokenSource? cts;

    protected override void OnInitialized()
    {
        LeagueState.Changed += OnLeagueChanged;
        cts = new CancellationTokenSource();
        _ = LoadAsync(cts.Token);
        _ = PollAsync(cts.Token);
    }

    private void OnLeagueChanged() => _ = InvokeAsync(async () =>
    {
        isLoading = true;
        report = null;
        StateHasChanged();
        await LoadAsync(cts?.Token ?? CancellationToken.None);
    });

    private async Task PollAsync(CancellationToken cancellationToken)
    {
        pollTimer = new PeriodicTimer(TimeSpan.FromSeconds(15));
        try
        {
            while (await pollTimer.WaitForNextTickAsync(cancellationToken))
            {
                await LoadAsync(cancellationToken);
            }
        }
        catch (OperationCanceledException)
        {
            // Page disposed.
        }
    }

    private async Task LoadAsync(CancellationToken cancellationToken)
    {
        try
        {
            var next = await DraftAssistant.GetReportAsync(cancellationToken);
            await InvokeAsync(() =>
            {
                report = next;
                isLoading = false;
                StateHasChanged();
            });
        }
        catch (OperationCanceledException)
        {
            // Page disposed mid-fetch.
        }
    }

    private static string NeedBadgeCss(PositionalNeedLevel level) => level switch
    {
        PositionalNeedLevel.Urgent => "pb-badge--warning",
        PositionalNeedLevel.Satisfied => "pb-badge--info",
        _ => ""
    };

    public void Dispose()
    {
        LeagueState.Changed -= OnLeagueChanged;
        cts?.Cancel();
        cts?.Dispose();
        pollTimer?.Dispose();
    }
}
